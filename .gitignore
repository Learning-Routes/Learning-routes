# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore compiled assets
/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Tailwind CSS builds
/app/assets/builds/*
!/app/assets/builds/.keep

# Docker volumes
/docker-data/

# macOS
.DS_Store
**/.DS_Store

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Node modules (if any)
/node_modules
# ANYWHERE, not just at the root. `/node_modules` is root-anchored, so
# `app/motion/node_modules` was never ignored and 8749 of its files were swept into
# a commit by a `git add -A`. WP-36 introduced that second package; any future one
# is covered now.
node_modules/
# WP-36's build output, for the same reason. The source under app/motion/ is NOT
# ignored — that branch tracks it, and ignoring it here would make it vanish on merge.
/app/motion/dist/

# Motion Canvas build tree (app/motion): dependencies and build output are
# regenerated by npm install / vite build; everything else under app/motion
# is committed.
/app/motion/node_modules
/app/motion/dist

# Coverage reports
/coverage/

# Claude Code
CLAUDE.md
/CLAUDE.md
db/*.sqlite3

# Ignore key files for decrypting credentials and more.
/config/credentials/*.key

