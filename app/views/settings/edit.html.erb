<% content_for(:title, t("settings.title")) %>

<div style="max-width:560px; margin:0 auto;" data-controller="auth-form"
     data-auth-form-required-msg-value="<%= t('auth_alerts.validation_required') %>"
     data-auth-form-email-msg-value="<%= t('auth_alerts.validation_email') %>"
     data-auth-form-min-length-msg-value="<%= t('auth_alerts.validation_min_length') %>">

  <%# === Page heading === %>
  <div style="margin-bottom:1.8rem;">
    <h1 class="page-title" style="margin:0 0 0.3rem;">
      <%= t("settings.heading") %>
    </h1>
    <p style="font-size:0.82rem; color:var(--color-muted); margin:0;">
      <%= t("settings.subheading") %>
    </p>
  </div>

  <%# ================================================================ %>
  <%# === MAIN SETTINGS FORM (account + preferences + learning)    === %>
  <%# ================================================================ %>
  <%= form_with(model: @user, url: settings_path, method: :patch) do |f| %>

    <%# Form errors %>
    <% errors = @user.errors.full_messages + @profile.errors.full_messages %>
    <% if errors.any? %>
      <div role="alert" style="background:var(--color-flash-alert-bg); border:1px solid var(--color-flash-alert-border); border-radius:12px; padding:0.75rem 0.9rem; margin-bottom:1.2rem;">
        <p style="font-size:0.76rem; font-weight:500; color:var(--color-flash-alert-text); margin:0 0 0.3rem;">
          <%= t("settings.errors", count: errors.size) %>
        </p>
        <ul style="margin:0; padding-left:1rem;">
          <% errors.each do |message| %>
            <li style="font-size:0.72rem; color:var(--color-flash-alert-text); line-height:1.5;"><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# ============================================ %>
    <%# SECTION 1: Account                          %>
    <%# ============================================ %>
    <section class="card3" style="padding:1.8rem 1.6rem; margin-bottom:1rem;">

      <h2 style="font-weight:600; font-size:1rem; color:var(--color-txt); margin:0 0 1.2rem; letter-spacing:-0.3px;">
        <%= t("settings.account.heading") %>
      </h2>

      <div style="display:flex; flex-direction:column; gap:1rem;">
        <%# Name %>
        <div>
          <%= f.label :name, t("settings.account.name_label"),
              style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
          <%= f.text_field :name,
              class: "input3", style: "display:block; width:100%;",
              placeholder: t("settings.account.name_placeholder"),
              required: true,
              autocomplete: "name",
              data: { auth_form_target: "input" } %>
        </div>

        <%# Email %>
        <div>
          <%= f.label :email, t("settings.account.email_label"),
              style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
          <%= f.email_field :email,
              class: "input3", style: "display:block; width:100%;",
              placeholder: t("settings.account.email_placeholder"),
              required: true,
              autocomplete: "email",
              data: { auth_form_target: "input", action: "input->auth-form#checkEmailChange" } %>
        </div>

        <%# Current password — only shown when email is being changed %>
        <div id="email-password-confirm" style="display:none;">
          <label for="current_password"
            style="display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;">
            <%= t("settings.account.confirm_password_label", default: "Current password (required to change email)") %>
          </label>
          <input type="password" name="current_password" id="current_password" autocomplete="current-password"
            class="input3" style="display:block; width:100%;">
        </div>
      </div>
    </section>

    <%# ============================================ %>
    <%# SECTION 2: Preferences                      %>
    <%# ============================================ %>
    <section class="card3" style="padding:1.8rem 1.6rem; margin-bottom:1rem;">

      <h2 style="font-weight:600; font-size:1rem; color:var(--color-txt); margin:0 0 1.2rem; letter-spacing:-0.3px;">
        <%= t("settings.preferences.heading") %>
      </h2>

      <div style="display:flex; flex-direction:column; gap:1rem;">
        <%# Language %>
        <div>
          <%= f.label :locale, t("settings.preferences.locale_label"),
              style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
          <%= f.select :locale,
              options_for_select([
                [t("settings.preferences.locale_en"), "en"],
                [t("settings.preferences.locale_es"), "es"]
              ], @user.locale),
              {},
              class: "input3", style: "display:block; width:100%; cursor:pointer;",
              data: { auth_form_target: "input" } %>
        </div>

        <%# Appearance (theme) %>
        <div>
          <p style="font-size:0.78rem; font-weight:500; color:var(--color-sub); margin:0 0 0.5rem;">
            <%= t("settings.preferences.theme_label") %>
          </p>
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <% [
              ["system", t("settings.preferences.theme_system")],
              ["light", t("settings.preferences.theme_light")],
              ["dark", t("settings.preferences.theme_dark")]
            ].each do |value, label| %>
              <label style="display:flex; align-items:center; gap:0.4rem; font-size:0.82rem; color:var(--color-txt);
                            padding:0.55rem 1rem; border-radius:10px; border:1px solid var(--color-border-subtle); background:var(--color-card); cursor:pointer; transition:all 0.2s;"
                     class="hover-border-faint">
                <input type="radio" name="user[theme]" value="<%= value %>"
                       <%= "checked" if @user.theme == value %>
                       style="accent-color:var(--color-accent);">
                <%= label %>
              </label>
            <% end %>
          </div>
        </div>

        <%# Timezone %>
        <div>
          <%= f.label :timezone, t("settings.preferences.timezone_label"),
              style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
          <%= f.time_zone_select :timezone,
              ActiveSupport::TimeZone.all,
              { default: @user.timezone || "UTC" },
              class: "input3", style: "display:block; width:100%; cursor:pointer;",
              data: { auth_form_target: "input" } %>
        </div>
      </div>
    </section>

    <%# ============================================ %>
    <%# SECTION 3: Learning Profile                 %>
    <%# ============================================ %>
    <section class="card3" style="padding:1.8rem 1.6rem; margin-bottom:1rem;">

      <h2 style="font-weight:600; font-size:1rem; color:var(--color-txt); margin:0 0 1.2rem; letter-spacing:-0.3px;">
        <%= t("settings.learning.heading") %>
      </h2>

      <div style="display:flex; flex-direction:column; gap:1.2rem;">

        <%# Current Level %>
        <div>
          <p style="font-size:0.78rem; font-weight:500; color:var(--color-sub); margin:0 0 0.5rem;">
            <%= t("settings.learning.level_label") %>
          </p>
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <% %w[beginner intermediate advanced].each do |level| %>
              <label style="display:flex; align-items:center; gap:0.4rem; font-size:0.82rem; color:var(--color-txt);
                            padding:0.55rem 1rem; border-radius:10px; border:1px solid var(--color-border-subtle); background:var(--color-card); cursor:pointer; transition:all 0.2s;"
                     class="hover-border-faint">
                <input type="radio" name="learning_profile[current_level]" value="<%= level %>"
                       <%= "checked" if @profile.current_level == level %>
                       style="accent-color:var(--color-accent);">
                <%= t("settings.learning.level_#{level}") %>
              </label>
            <% end %>
          </div>
        </div>

        <%# Interests %>
        <div>
          <p style="font-size:0.78rem; font-weight:500; color:var(--color-sub); margin:0 0 0.5rem;">
            <%= t("settings.learning.interests_label") %>
          </p>
          <% interest_options = %w[programming web_development data_science mobile_development devops cybersecurity ai_ml databases] %>
          <div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
            <% interest_options.each do |interest| %>
              <label style="display:flex; align-items:center; gap:0.35rem; font-size:0.78rem; color:var(--color-txt);
                            padding:0.45rem 0.8rem; border-radius:9px; border:1px solid var(--color-border-subtle); background:var(--color-card); cursor:pointer; transition:all 0.2s;"
                     class="hover-border-faint">
                <input type="checkbox" name="learning_profile[interests][]" value="<%= interest %>"
                       <%= "checked" if @profile.interests&.include?(interest) %>
                       style="accent-color:var(--color-accent); width:14px; height:14px;">
                <%= t("settings.learning.interest_#{interest}", default: interest.humanize) %>
              </label>
            <% end %>
          </div>
        </div>

        <%# Learning Style %>
        <div>
          <p style="font-size:0.78rem; font-weight:500; color:var(--color-sub); margin:0 0 0.5rem;">
            <%= t("settings.learning.style_label") %>
          </p>
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <% %w[visual auditory reading kinesthetic].each do |style| %>
              <label style="display:flex; align-items:center; gap:0.35rem; font-size:0.82rem; color:var(--color-txt);
                            padding:0.5rem 0.9rem; border-radius:10px; border:1px solid var(--color-border-subtle); background:var(--color-card); cursor:pointer; transition:all 0.2s;"
                     class="hover-border-faint">
                <input type="checkbox" name="learning_profile[learning_style][]" value="<%= style %>"
                       <%= "checked" if @profile.learning_style&.include?(style) %>
                       style="accent-color:var(--color-accent); width:14px; height:14px;">
                <%= t("settings.learning.style_#{style}") %>
              </label>
            <% end %>
          </div>
        </div>

        <%# Goal %>
        <div>
          <label style="display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;"
                 for="learning_profile_goal">
            <%= t("settings.learning.goal_label") %>
          </label>
          <textarea name="learning_profile[goal]" id="learning_profile_goal" rows="3"
                    class="input3" style="display:block; width:100%; resize:vertical;"
                    placeholder="<%= t('settings.learning.goal_placeholder') %>"
                    data-auth-form-target="input"
                    ><%= @profile.goal %></textarea>
        </div>

        <%# Timeline %>
        <div>
          <label style="display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;"
                 for="learning_profile_timeline">
            <%= t("settings.learning.timeline_label") %>
          </label>
          <select name="learning_profile[timeline]" id="learning_profile_timeline"
                  class="input3" style="display:block; width:100%; cursor:pointer;"
                  data-auth-form-target="input"
                  >
            <% %w[1_month 3_months 6_months 1_year].each do |tl| %>
              <option value="<%= tl %>" <%= "selected" if @profile.timeline == tl %>><%= t("settings.learning.timeline_#{tl}") %></option>
            <% end %>
          </select>
        </div>
      </div>
    </section>

    <%# === Save button === %>
    <div style="margin-bottom:1.8rem;">
      <%= f.submit t("settings.save"), class: "btn3", style: "width:100%;", data: { auth_form_target: "submit" } %>
    </div>
  <% end %>

  <%# ============================================ %>
  <%# SECTION 4: Change Password (separate form)  %>
  <%# ============================================ %>
  <section class="card3" style="padding:1.8rem 1.6rem; margin-bottom:1rem;">

    <%# A Google account with only its random sign-up password creates one instead
        (STEP 38 §5). From the database, so a failed attempt re-renders the same variant. %>
    <% own_password = @user.own_password_in_database %>
    <h2 style="font-weight:600; font-size:1rem; color:var(--color-txt); margin:0 0 1.2rem; letter-spacing:-0.3px;">
      <%= t(own_password ? "settings.password.heading" : "settings.password.create_heading") %>
    </h2>
    <% unless own_password %>
      <p style="font-size:0.82rem; color:var(--color-sub); margin:-0.6rem 0 1.2rem;">
        <%= t("settings.password.create_hint") %>
      </p>
    <% end %>

    <%= form_with(url: settings_password_path, method: :patch) do |f| %>
      <div style="display:flex; flex-direction:column; gap:1rem;">
        <%# Current password %>
        <% if own_password %>
        <div>
          <%= f.label :current_password, t("settings.password.current_label"),
              style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
          <%= f.password_field :current_password,
              class: "input3", style: "display:block; width:100%;",
              placeholder: t("settings.password.current_placeholder"),
              required: true,
              autocomplete: "current-password",
              data: { auth_form_target: "input" } %>
        </div>
        <% end %>

        <%# New password %>
        <div>
          <%= f.label :new_password, t("settings.password.new_label"),
              style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
          <%= f.password_field :new_password,
              class: "input3", style: "display:block; width:100%;",
              placeholder: t("settings.password.new_placeholder"),
              required: true,
              minlength: 8,
              autocomplete: "new-password",
              data: { auth_form_target: "input" } %>
        </div>

        <%# Confirm password %>
        <div>
          <%= f.label :new_password_confirmation, t("settings.password.confirm_label"),
              style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
          <%= f.password_field :new_password_confirmation,
              class: "input3", style: "display:block; width:100%;",
              placeholder: t("settings.password.confirm_placeholder"),
              required: true,
              autocomplete: "new-password",
              data: { auth_form_target: "input" } %>
        </div>

        <%# Submit %>
        <div style="margin-top:0.3rem;">
          <%= f.submit t(own_password ? "settings.password.submit" : "settings.password.create_submit"), class: "btn3 btn3--secondary", style: "width:100%;" %>
        </div>
      </div>
    <% end %>
  </section>

  <%# === Back to profile link === %>
  <p style="text-align:center; margin:1rem 0 0; font-size:0.78rem; color:var(--color-muted);">
    <%= link_to t("settings.back_to_profile"), profile_path,
        style: "color:var(--color-link); text-decoration:none; font-weight:600;" %>
  </p>

</div>
