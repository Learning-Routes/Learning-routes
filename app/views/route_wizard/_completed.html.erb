<div id="generating-state" style="text-align:center; padding:60px 0;">
  <div style="margin:0 auto 24px; width:64px; height:64px; border-radius:50%; background:var(--color-positive-bg); display:flex; align-items:center; justify-content:center; animation:wizardScaleIn 0.5s cubic-bezier(0.16,1,0.3,1) both;">
    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
      <path d="M7 14L12 19L21 9" stroke="var(--color-progress-bar)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <h2 style="font-weight:700; font-size:1.3rem; letter-spacing:-0.3px; color:var(--color-txt); margin:0 0 8px;">
    <%= t("wizard.completed.title") %>
  </h2>

  <% if route_request.learning_route %>
    <p style="font-weight:400; font-size:0.85rem; color:var(--color-muted); margin:0 0 28px;">
      <%= route_request.learning_route.localized_topic %>
    </p>
  <% end %>

  <a href="<%= profile_path %>"
     class="btn3"
     class="btn-lift">
    <%= t("wizard.completed.cta") %> <span style="font-size:0.9rem; opacity:0.7;">→</span>
  </a>

  <script nonce="<%= content_security_policy_nonce %>">setTimeout(function() { window.location.href = "<%= ERB::Util.html_escape(profile_path) %>"; }, 3000);</script>
</div>
