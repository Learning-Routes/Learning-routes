<div id="generating-state" style="text-align:center; padding:60px 0;">
  <div style="margin:0 auto 24px; width:64px; height:64px; border-radius:50%; background:var(--color-negative-bg); display:flex; align-items:center; justify-content:center;">
    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
      <path d="M14 8v7" stroke="var(--color-flash-alert-text)" stroke-width="2" stroke-linecap="round"/>
      <circle cx="14" cy="19.5" r="1.2" fill="var(--color-flash-alert-text)"/>
      <circle cx="14" cy="14" r="11" stroke="var(--color-flash-alert-text)" stroke-width="1.5" fill="none"/>
    </svg>
  </div>

  <h2 style="font-weight:700; font-size:1.15rem; letter-spacing:-0.3px; color:var(--color-txt); margin:0 0 8px;">
    <%= t("wizard.failed.title") %>
  </h2>

  <p style="font-weight:400; font-size:0.78rem; color:var(--color-muted); margin:0 auto 28px; max-width:300px; line-height:1.5;">
    <%= t("wizard.failed.desc") %>
  </p>

  <a href="<%= new_route_wizard_path %>"
     class="btn3"
     class="btn-lift">
    <%= t("wizard.failed.retry") %>
  </a>
</div>
