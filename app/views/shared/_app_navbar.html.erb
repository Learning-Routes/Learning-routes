<%#
  Authenticated app navbar — used on dashboard, profile, and all logged-in pages.
  Different from landing navbar: has user-specific nav links + avatar.
%>

<nav data-controller="app-nav engagement" class="app-navbar" style="position:sticky; top:0; z-index:50; backdrop-filter:blur(16px) saturate(1.4); -webkit-backdrop-filter:blur(16px) saturate(1.4);">
  <div style="display:flex; align-items:center; justify-content:space-between; max-width:1100px; margin:0 auto; padding:0 clamp(1rem,3vw,2.25rem); height:56px;">

    <%# === Left: Logo === %>
    <%= link_to main_app.root_path, data: { nav: "logo" }, style: "display:flex; align-items:center; gap:0.5rem; text-decoration:none;" do %>
      <%= render "shared/logo", size: 28 %>
      <span style="font-weight:800; font-size:0.95rem; letter-spacing:-0.6px; color:var(--color-txt);">Learning Routes</span>
    <% end %>

    <%# === Center: Nav links (desktop) === %>
    <div style="display:flex; align-items:center; gap:1.8rem;" class="hidden md:flex">
      <%
        nav_links = [
          { label: t("nav.home"), path: main_app.root_path, match: "landing", nav: "home" },
          { label: t("nav.my_routes"), path: main_app.profile_path, match: "profiles" },
          { label: t("nav.community"), path: main_app.community_path, match: "community" }
        ]
      %>
      <% nav_links.each do |link| %>
        <% is_active = link[:match] && controller_name == link[:match] %>
        <%= link_to link[:path], data: { nav: link[:nav] },
            style: "position:relative; font-size:0.78rem; font-weight:#{is_active ? '600' : '400'}; color:#{is_active ? 'var(--color-txt)' : 'var(--color-muted)'}; text-decoration:none; padding:0.35rem 0; transition:color 0.2s;",
            class: "nav-link" do %>
          <%= link[:label] %>
          <% if is_active %>
            <span style="position:absolute; bottom:-1px; left:0; right:0; height:1.5px; background:var(--color-progress-bar); border-radius:1px;"></span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# === Right: Engagement + controls === %>
    <div style="display:flex; align-items:center; gap:0.8rem;">

      <%# Engagement stats (streak, XP, level) %>
      <% if current_user&.user_engagement %>
        <div id="engagement_stats" class="hidden md:flex">
          <%= render "shared/engagement_bar", engagement: current_user.user_engagement %>
        </div>
        <div class="hidden md:block" style="width:1px; height:20px; background:var(--color-faint, rgba(28,24,18,0.08));"></div>
      <% end %>

      <%# Theme toggle (desktop) %>
      <div class="hidden md:block">
        <%= render "shared/theme_toggle" %>
      </div>

      <%# Locale toggle (desktop) %>
      <div class="hidden md:block">
        <%= render "shared/locale_toggle" %>
      </div>

      <%# Sign out (desktop) %>
      <%= button_to core.sign_out_path, method: :delete,
          style: "font-size:0.72rem; font-weight:500; color:var(--color-muted); background:none; border:none; cursor:pointer; padding:0.3rem 0; transition:color 0.2s;",
          class: "hidden md:block nav-link" do %>
        <%= t("nav.sign_out") %>
      <% end %>

      <%# Notification bell (desktop) %>
      <div class="hidden md:block">
        <% if current_user %>
          <%= render "community_engine/notifications/dropdown" %>
        <% end %>
      </div>

      <%# Settings gear (desktop) %>
      <%= link_to main_app.settings_path, style: "color:var(--color-muted); transition:color 0.2s; padding:0.2rem;", class: "hidden md:inline-flex nav-link", title: t("nav.settings") do %>
        <%= svg_icon(:settings, size: 17) %>
      <% end %>

      <%# User avatar — links to profile %>
      <% initials = current_user.name.to_s.split.map(&:first).join.upcase.slice(0,2) %>
      <%= link_to main_app.profile_path, style: "text-decoration:none;" do %>
        <div style="width:32px; height:32px; border-radius:10px; background:linear-gradient(135deg, rgba(139,128,196,0.2), rgba(110,155,200,0.2)); display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:transform 0.15s;"
             class="avatar-hover">
          <span style="font-weight:700; font-size:0.7rem; color:var(--color-sub); letter-spacing:0.3px;"><%= initials %></span>
        </div>
      <% end %>

      <%# Mobile hamburger %>
      <button data-action="click->app-nav#toggleMenu"
              data-app-nav-target="menuBtn"
              style="padding:0.4rem; margin-right:-0.4rem; color:var(--color-txt); background:none; border:none; cursor:pointer;"
              class="inline-flex md:hidden" aria-label="<%= t("layout.menu_aria") %>" aria-expanded="false" aria-controls="app-mobile-menu">
        <%= svg_icon(:menu, size: 20) %>
      </button>
    </div>
  </div>

  <%# === Mobile menu === %>
  <div id="app-mobile-menu" data-app-nav-target="menu" style="display:none; border-top:1px solid var(--color-faint, rgba(28,24,18,0.04)); padding:0.75rem clamp(1rem,3vw,2.25rem) 1rem;" class="md:hidden">
    <div style="display:flex; flex-direction:column; gap:0.5rem;">
      <%
        nav_links = [
          { label: t("nav.home"), path: main_app.root_path, match: "landing", nav: "home" },
          { label: t("nav.my_routes"), path: main_app.profile_path, match: "profiles" },
          { label: t("nav.community"), path: main_app.community_path, match: "community" }
        ]
      %>
      <% nav_links.each do |link| %>
        <% is_active = link[:match] && controller_name == link[:match] %>
        <%= link_to link[:label], link[:path], data: { nav: link[:nav] },
            style: "font-size:0.88rem; font-weight:#{is_active ? '600' : '400'}; color:#{is_active ? 'var(--color-txt)' : 'var(--color-sub)'}; text-decoration:none; padding:0.45rem 0; transition:color 0.2s;" %>
      <% end %>
      <%= link_to t("nav.settings"), main_app.settings_path,
          style: "font-size:0.88rem; font-weight:#{controller_name == 'settings' ? '600' : '400'}; color:#{controller_name == 'settings' ? 'var(--color-txt)' : 'var(--color-sub)'}; text-decoration:none; padding:0.45rem 0; transition:color 0.2s;" %>
      <% if current_user&.user_engagement %>
        <div style="padding:0.45rem 0;">
          <%= render "shared/engagement_bar", engagement: current_user.user_engagement %>
        </div>
      <% end %>
      <div style="display:flex; align-items:center; gap:0.6rem; padding:0.45rem 0;">
        <%= render "shared/theme_toggle" %>
        <%= render "shared/locale_toggle" %>
      </div>
      <div style="padding-top:0.5rem; border-top:1px solid var(--color-faint, rgba(28,24,18,0.04)); margin-top:0.25rem;">
        <%= button_to t("nav.sign_out"), core.sign_out_path, method: :delete,
            style: "font-size:0.88rem; font-weight:400; color:var(--color-muted); background:none; border:none; cursor:pointer; padding:0.45rem 0;" %>
      </div>
    </div>
  </div>
</nav>
