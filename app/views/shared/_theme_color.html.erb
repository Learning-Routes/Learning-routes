<%# The browser bar's colour: --color-bg of each theme. It is read by the browser,
    not CSS, so it cannot be a token (exempt from the palette sweep). It follows
    the system scheme; an in-app theme choice does not reach it. %>
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#F5F1EB">
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1A1710">
