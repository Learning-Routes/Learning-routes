<%#
  Footer — logo, link columns, copyright.
  Shared partial used across layouts.
%>

<footer style="width: 100%; border-top: 1px solid var(--color-faint); margin-top: 1rem;">
  <div style="max-width: 1100px; margin: 0 auto; padding: 4rem clamp(1.5rem,5vw,4rem) 2.5rem;">

    <%# Main row: brand left, links right %>
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 3rem;">

      <%# Left: brand + tagline %>
      <div style="max-width: 320px;">
        <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.75rem;">
          <%= render "shared/logo", size: 20 %>
          <span style="font-weight: 700;
                       font-size: 1.05rem; letter-spacing: -0.5px; color: var(--color-txt);">
            Learning Routes
          </span>
        </div>
        <p style="font-size: 0.9rem;
                  line-height: 1.5; color: var(--color-muted); margin: 0;">
          <%= t("footer.tagline") %>
        </p>
      </div>

      <%# Right: link columns %>
      <div style="display: flex; flex-wrap: wrap; gap: clamp(2rem,4vw,5rem);">

        <%# Product %>
        <div>
          <p class="font-mono" style="font-size: 0.7rem; font-weight: 500;
                    text-transform: uppercase; letter-spacing: 1.2px; color: var(--color-muted);
                    margin: 0 0 1.1rem 0;">
            <%= t("footer.product") %>
          </p>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.7rem;">
            <li>
              <a href="#features" style="font-size: 0.88rem;
                                 color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                 class="footer-link"><%= t("nav.features") %></a>
            </li>
            <li>
              <a href="#how-it-works" style="font-size: 0.88rem;
                                 color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                 class="footer-link"><%= t("nav.how_it_works") %></a>
            </li>
            <li>
              <% if current_user %>
                <a href="<%= main_app.dashboard_path %>" style="font-size: 0.88rem;
                                   color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                   class="footer-link"><%= t("nav.dashboard") %></a>
              <% else %>
                <a href="<%= core.sign_up_path %>" style="font-size: 0.88rem;
                                   color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                   class="footer-link"><%= t("nav.sign_up") %></a>
              <% end %>
            </li>
          </ul>
        </div>

        <%# Legal %>
        <div>
          <p class="font-mono" style="font-size: 0.7rem; font-weight: 500;
                    text-transform: uppercase; letter-spacing: 1.2px; color: var(--color-muted);
                    margin: 0 0 1.1rem 0;">
            <%= t("footer.legal") %>
          </p>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.7rem;">
            <li>
              <a href="<%= main_app.terms_path %>" style="font-size: 0.88rem;
                                 color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                 class="footer-link"><%= t("footer.terms") %></a>
            </li>
            <li>
              <a href="<%= main_app.privacy_path %>" style="font-size: 0.88rem;
                                 color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                 class="footer-link"><%= t("footer.privacy") %></a>
            </li>
            <li>
              <a href="mailto:hello@learningroutes.com" style="font-size: 0.88rem;
                                 color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                 class="footer-link"><%= t("footer.contact") %></a>
            </li>
          </ul>
        </div>

        <%# Account %>
        <div>
          <p class="font-mono" style="font-size: 0.7rem; font-weight: 500;
                    text-transform: uppercase; letter-spacing: 1.2px; color: var(--color-muted);
                    margin: 0 0 1.1rem 0;">
            <%= t("footer.account") %>
          </p>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.7rem;">
            <% if current_user %>
              <li>
                <a href="<%= main_app.profile_path %>" style="font-size: 0.88rem;
                                   color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                   class="footer-link"><%= t("nav.profile") %></a>
              </li>
              <li>
                <a href="<%= main_app.dashboard_path %>" style="font-size: 0.88rem;
                                   color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                   class="footer-link"><%= t("nav.dashboard") %></a>
              </li>
            <% else %>
              <li>
                <a href="<%= core.sign_in_path %>" style="font-size: 0.88rem;
                                   color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                   class="footer-link"><%= t("nav.sign_in") %></a>
              </li>
              <li>
                <a href="<%= core.sign_up_path %>" style="font-size: 0.88rem;
                                   color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                   class="footer-link"><%= t("nav.sign_up") %></a>
              </li>
            <% end %>
            <li>
              <a href="<%= main_app.community_path %>" style="font-size: 0.88rem;
                                 color: var(--color-sub); text-decoration: none; transition: color 0.2s ease;"
                 class="footer-link"><%= t("nav.community") %></a>
            </li>
          </ul>
        </div>

      </div>
    </div>

    <%# Separator %>
    <div style="height: 1px; margin: 3rem 0 1.5rem;
                background: linear-gradient(90deg, var(--color-faint), var(--color-faint), var(--color-faint));">
    </div>

    <%# Bottom row: copyright + social hints %>
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <p class="font-mono" style="font-size: 0.75rem; color: var(--color-muted); margin: 0;">
        <%= t("footer.copyright") %>
      </p>

      <div style="display: flex; align-items: center; gap: 1.2rem;">
        <%# GitHub %>
        <a href="https://github.com/learning-routes" target="_blank" rel="noopener noreferrer" aria-label="GitHub" style="color: var(--color-muted); transition: color 0.2s ease;"
           class="social-link">
          <%= svg_icon(:github, size: 18) %>
        </a>
        <%# Twitter / X %>
        <a href="https://x.com/learningroutes" target="_blank" rel="noopener noreferrer" aria-label="Twitter" style="color: var(--color-muted); transition: color 0.2s ease;"
           class="social-link">
          <%= svg_icon(:x_logo, size: 18) %>
        </a>
      </div>
    </div>

  </div>
</footer>
