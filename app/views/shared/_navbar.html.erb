<%# STEP 41 §3.3: the reference's bar (as on the landing) for terms, privacy and
    the app's pages signed out. The theme and language switches are the app's. %>
<%# On a public page (Terms, Privacy) the links into the app are full loads, so Clarity does not follow; elsewhere they stay Turbo visits. %>
<nav data-controller="navbar" class="site-nav">
  <div data-navbar-target="bar" class="site-nav__bar">
    <%= link_to main_app.root_path, data: { nav: "logo" }, class: "site-nav__brand" do %>
      <%= render "shared/logo", size: 26 %><span>Learning Routes</span>
    <% end %>

    <div class="site-nav__links">
      <a href="<%= main_app.root_path(anchor: "como") %>" class="site-nav__link"><%= t("nav.how_it_works") %></a>
      <% if current_user %>
        <%= link_to t("nav.home"), main_app.root_path, data: { nav: "home" }, class: "site-nav__link" %>
        <%= link_to t("nav.dashboard"), main_app.dashboard_path, class: "site-nav__link", data: { turbo: (false if public_page?) } %>
      <% else %>
        <%= link_to t("nav.sign_in"), core.sign_in_path, class: "site-nav__link" %>
      <% end %>
      <%= render "shared/theme_toggle" %>
      <%= render "shared/locale_toggle" %>
      <% if current_user %>
        <%= link_to t("nav.profile"), main_app.profile_path, class: "btn3 btn3--sm", data: { turbo: (false if public_page?) } %>
      <% else %>
        <%= link_to t("nav.sign_up"), core.sign_up_path, class: "btn3 btn3--sm" %>
      <% end %>
    </div>

    <button data-action="navbar#toggleMenu" data-navbar-target="menuBtn" class="site-nav__menu-btn"
            aria-label="<%= t("layout.menu_aria") %>" aria-expanded="false" aria-controls="navbar-mobile-menu">
      <%= svg_icon(:menu, size: 20) %>
    </button>
  </div>

  <div id="navbar-mobile-menu" data-navbar-target="menu" class="site-nav__menu hidden">
    <a href="<%= main_app.root_path(anchor: "como") %>" data-action="navbar#closeMenu" class="site-nav__link"><%= t("nav.how_it_works") %></a>
    <% if current_user %>
      <%= link_to t("nav.home"), main_app.root_path, data: { nav: "home", action: "navbar#closeMenu" }, class: "site-nav__link" %>
      <%= link_to t("nav.dashboard"), main_app.dashboard_path, data: { action: "navbar#closeMenu", turbo: (false if public_page?) }, class: "site-nav__link" %>
    <% else %>
      <%= link_to t("nav.sign_in"), core.sign_in_path, data: { action: "navbar#closeMenu" }, class: "site-nav__link" %>
    <% end %>
    <div class="site-nav__toggles">
      <%= render "shared/theme_toggle" %>
      <%= render "shared/locale_toggle" %>
    </div>
    <% if current_user %>
      <%= link_to t("nav.profile"), main_app.profile_path, class: "btn3 w-full", data: { turbo: (false if public_page?) } %>
    <% else %>
      <%= link_to t("nav.sign_up"), core.sign_up_path, class: "btn3 w-full" %>
    <% end %>
  </div>
</nav>
