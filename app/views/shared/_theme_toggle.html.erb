<%# Theme toggle — instant JS switching, persists via PATCH in background %>
<%
  current_theme = if current_user
    current_user.theme
  else
    cookies[:theme] || "system"
  end
%>
<button class="font-mono" type="button"
  data-controller="theme-toggle"
  data-theme-toggle-current-value="<%= current_theme %>"
  data-theme-toggle-url-value="<%= main_app.theme_path %>"
  data-theme-toggle-csrf-value="<%= form_authenticity_token %>"
  data-action="click->theme-toggle#cycle"
  style="font-size:0.65rem; font-weight:500; letter-spacing:0.8px;
         color:var(--color-muted); background:transparent; border:1px solid var(--color-border-subtle);
         border-radius:8px; padding:0.3rem 0.6rem; cursor:pointer; transition:all 0.2s;
         line-height:1; display:inline-flex; align-items:center; gap:0.3rem;"
  class="theme-toggle"
  title="<%= t("theme_toggle.switch_to_#{current_theme == 'system' ? 'light' : current_theme == 'light' ? 'dark' : 'system'}") %>">
  <%# System icon %>
  <%= svg_icon(:monitor, size: 12, data: { theme_toggle_target: "systemIcon" }, style: (current_theme != "system" ? "display:none;" : "")) %>
  <%# Light icon %>
  <%= svg_icon(:sun, size: 12, data: { theme_toggle_target: "lightIcon" }, style: (current_theme != "light" ? "display:none;" : "")) %>
  <%# Dark icon %>
  <%= svg_icon(:moon, size: 12, data: { theme_toggle_target: "darkIcon" }, style: (current_theme != "dark" ? "display:none;" : "")) %>
</button>
