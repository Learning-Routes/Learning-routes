<%# Renders the Learning Routes logo SVG at any size.
    Usage: render "shared/logo", size: 28 %>
<% size ||= 28 %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180" fill="none" aria-hidden="true"
     width="<%= size %>" height="<%= size %>" style="display:block; flex-shrink:0;">
  <defs>
    <linearGradient id="rg-<%= size %>" x1="90" y1="155" x2="90" y2="25" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="var(--color-accent)"/>
      <stop offset="30%" stop-color="var(--color-node-nv3)"/>
      <stop offset="60%" stop-color="var(--color-node-nv2)"/>
      <stop offset="100%" stop-color="var(--color-progress-bar)"/>
    </linearGradient>
    <radialGradient id="dg-<%= size %>" cx="90" cy="28" r="18" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="var(--color-progress-bar)" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="var(--color-progress-bar)" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <circle cx="90" cy="28" r="18" fill="url(#dg-<%= size %>)"/>
  <path d="M90 152 C90 138, 58 130, 52 115 C46 100, 80 95, 90 85 C100 75, 130 72, 128 58 C126 44, 98 40, 90 32"
        stroke="url(#rg-<%= size %>)" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M52 115 C42 112, 36 105, 38 96" stroke="var(--color-node-nv2)" stroke-width="3.5" stroke-linecap="round" opacity="0.85"/>
  <path d="M128 58 C136 54, 142 48, 140 40" stroke="var(--color-highlight)" stroke-width="3.5" stroke-linecap="round" opacity="0.85"/>
  <circle cx="90" cy="152" r="5.5" fill="var(--color-accent)"/>
  <circle cx="88.5" cy="150.5" r="1.5" fill="white" opacity="0.35"/>
  <circle cx="38" cy="96" r="7" fill="var(--color-node-nv2)"/>
  <circle cx="36" cy="94" r="2" fill="white" opacity="0.35"/>
  <circle cx="140" cy="40" r="6" fill="var(--color-highlight)"/>
  <circle cx="138.5" cy="38.5" r="1.8" fill="white" opacity="0.35"/>
  <circle cx="90" cy="28" r="9" fill="var(--color-progress-bar)"/>
  <circle cx="87.5" cy="25.5" r="2.5" fill="white" opacity="0.4"/>
</svg>
