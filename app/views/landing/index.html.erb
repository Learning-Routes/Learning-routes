<% content_for(:title, t("landing.page_title")) %>

<% content_for(:head) do %>
  <%= render "shared/public_head", description: t("landing.meta_description") %>
  <%# STEP 36 §3: who publishes the site, the site in both languages, and the app. %>
  <script type="application/ld+json" nonce="<%= content_security_policy_nonce %>">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Learning Routes",
      "url": "<%= j public_url %>",
      "logo": "<%= j public_url("/icon.png") %>"<% if ApplicationHelper::SAME_AS.any? %>,
      "sameAs": [<% ApplicationHelper::SAME_AS.each_with_index do |profile, i| %><%= ", " if i.positive? %>"<%= j profile %>"<% end %>]<% end %>
    }
  </script>
  <script type="application/ld+json" nonce="<%= content_security_policy_nonce %>">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Learning Routes",
      "url": "<%= j public_url(main_app.root_path) %>",
      "inLanguage": ["es", "en"]
    }
  </script>
  <script type="application/ld+json" nonce="<%= content_security_policy_nonce %>">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Learning Routes",
      "url": "<%= j public_url(main_app.root_path) %>",
      "description": "<%= j t('landing.meta_description') %>",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  </script>
<% end %>

<% content_for(:body_class, "lp") %>
<% content_for(:main_class, "lp-main") %>
<% content_for(:nav) { render "landing/nav" } %>
<% content_for(:footer) { render "landing/footer" } %>

<%= render "landing/stage" %>
<%= render "landing/close" %>
