<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-controller="theme" data-theme-preference-value="<%= current_theme %>">
  <head>
    <meta charset="utf-8">
    <%= render "shared/gtm_head" %>
    <title><%= content_for(:title) || t("layout.app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Learning Routes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= render "shared/theme_color" %>
    <link rel="manifest" href="/manifest">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-prefetch" content="true">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">

    <%= yield :head %>

    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">

    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%# Prevent flash of wrong theme before JS loads %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function(){
        var p = "<%= current_theme %>";
        var t = p === "system" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : p;
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>

    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="margin:0; min-height:100vh; background:var(--color-bg); color:var(--color-txt); transition:background-color 0.3s, color 0.3s;">
    <%= render "shared/gtm_body" %>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:bg-accent focus:text-accent-text focus:px-4 focus:py-2 focus:rounded-btn focus:text-sm focus:font-semibold"><%= t("layout.skip_to_content") %></a>

    <%# === Subtle background texture (fixed, decorative) === %>
    <div style="position:fixed; inset:0; pointer-events:none; z-index:0;
                background:
                  radial-gradient(ellipse at 15% 25%, color-mix(in srgb, var(--color-accent) 4%, transparent) 0%, transparent 55%),
                  radial-gradient(ellipse at 85% 65%, color-mix(in srgb, var(--color-reinforce) 3%, transparent) 0%, transparent 50%);"
         class="theme-bg-texture"></div>

    <%# === Authenticated navbar (hidden when content_for(:hide_navbar) is set) === %>
    <% unless content_for?(:hide_navbar) %>
      <% if current_user %>
        <%= render "shared/app_navbar" %>
      <% else %>
        <%= render "shared/navbar" %>
      <% end %>
    <% end %>

    <%# === Flash messages === %>
    <% if flash[:notice] || flash[:alert] %>
      <div style="max-width:840px; margin:0 auto; padding:1rem 1.5rem 0;">
        <% if flash[:notice] %>
          <div data-controller="flash"
               style="background:var(--color-flash-notice-bg); border:1px solid var(--color-flash-notice-border); border-radius:14px; padding:0.875rem 1.25rem; margin-bottom:0.5rem; box-shadow:0 2px 8px rgba(91,168,128,0.08); animation:flashSlideIn 0.3s ease;">
            <div style="display:flex; align-items:center; gap:0.625rem;">
              <%= svg_icon(:check, size: 16, style: "flex-shrink:0; color:var(--color-flash-notice-text);") %>
              <p style="font-size:0.875rem; font-weight:500; color:var(--color-flash-notice-text); margin:0; flex:1;"><%= flash[:notice] %></p>
              <button data-action="click->flash#dismiss" style="background:none; border:none; cursor:pointer; color:var(--color-flash-notice-text); padding:0.2rem; opacity:0.6; transition:opacity 0.2s;" aria-label="<%= t(%(layout.dismiss)) %>">
                <%= svg_icon(:close, size: 14) %>
              </button>
            </div>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div data-controller="flash"
               style="background:var(--color-flash-alert-bg); border:1px solid var(--color-flash-alert-border); border-radius:14px; padding:0.875rem 1.25rem; margin-bottom:0.5rem; box-shadow:0 2px 8px rgba(176,96,80,0.08); animation:flashSlideIn 0.3s ease;">
            <div style="display:flex; align-items:center; gap:0.625rem;">
              <%= svg_icon(:alert_circle, size: 16, style: "flex-shrink:0; color:var(--color-flash-alert-text);") %>
              <p style="font-size:0.875rem; font-weight:500; color:var(--color-flash-alert-text); margin:0; flex:1;"><%= flash[:alert] %></p>
              <button data-action="click->flash#dismiss" style="background:none; border:none; cursor:pointer; color:var(--color-flash-alert-text); padding:0.2rem; opacity:0.6; transition:opacity 0.2s;" aria-label="<%= t(%(layout.dismiss)) %>">
                <%= svg_icon(:close, size: 14) %>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# === Main content === %>
    <% if content_for?(:full_width) %>
      <main id="main-content" style="position:relative; z-index:1; margin:0 auto; padding:44px 0 80px;">
        <%= yield %>
      </main>
    <% else %>
      <main id="main-content" style="position:relative; z-index:1; max-width:840px; margin:0 auto; padding:44px 24px 80px;">
        <%= yield %>
      </main>
    <% end %>

    <%# === Celebration container (Turbo Stream target) === %>
    <div id="celebrations" style="position:fixed; inset:0; pointer-events:none; z-index:9998;"></div>

  </body>
</html>
