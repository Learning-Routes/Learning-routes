<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-controller="theme" data-theme-preference-value="<%= current_theme %>">
  <head>
    <meta charset="utf-8">
    <%= render "shared/gtm_head" %>
    <title><%= content_for(:title) || t("layout.app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= render "shared/theme_color" %>
    <link rel="manifest" href="/manifest">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-prefetch" content="true">

    <%= yield :head %>

    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%# Prevent flash of wrong theme before JS loads %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function(){
        var p = "<%= current_theme %>";
        var t = p === "system" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : p;
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>

    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="jm-sans" style="height:100%; margin:0; background:var(--color-bg); color:var(--color-txt); overflow:hidden; transition:background-color 0.3s, color 0.3s;">
    <%= render "shared/gtm_body" %>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-[200] focus:bg-accent focus:text-accent-text focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold"><%= t("layout.skip_to_content") %></a>

    <%# Fixed top bar %>
    <nav id="journey-topbar" style="position:fixed; top:0; left:0; right:0; z-index:30; padding:14px 28px; background:linear-gradient(var(--color-bg) 50%, transparent); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); display:flex; justify-content:space-between; align-items:center;">
      <%= link_to main_app.profile_path, style: "font-size:0.72rem; color:var(--color-muted); text-decoration:none; transition:color 0.2s;", "aria-label": t("learning_engine.journey.back_to_profile") do %>
        &larr; <%= t("learning_engine.journey.back_to_profile") %>
      <% end %>

      <div style="display:flex; align-items:center; gap:12px;">
        <% if @due_reviews&.any? %>
          <%= link_to learning_routes_engine.reviews_path, class: "jm-mono", style: "display:inline-flex; align-items:center; gap:4px; font-size:0.55rem; color:var(--color-due-heading); text-decoration:none; background:var(--color-due-bg); padding:3px 8px; border-radius:6px;" do %>
            <%= svg_icon(:clock, size: 10) %>
            <%= @due_reviews.size %>
          <% end %>
        <% end %>
        <% if @progress %>
          <%# WP-37b brief §4.1: one title (the map's h1), so the bar carries the
              count and a progress line, in the accent like the route (STEP 41). %>
          <% total = @progress[:total_steps].to_i %>
          <% percent = total.positive? ? (100.0 * @progress[:completed_steps].to_i / total).round : 0 %>
          <span class="jm-counter" data-journey-counter>
            <span class="jm-counter__text"><%= t("learning_engine.journey.counter", done: @progress[:completed_steps], total: total, percent: percent) %></span>
            <span class="jm-counter__track" aria-hidden="true"><span class="jm-counter__fill" style="width: <%= percent %>%;"></span></span>
          </span>
        <% end %>
      </div>
    </nav>

    <%# Flash messages %>
    <% if flash[:notice] || flash[:alert] %>
      <div style="position:fixed; top:52px; left:50%; transform:translateX(-50%); z-index:40; max-width:500px; width:90%;">
        <% if flash[:notice] %>
          <div role="status" style="background:var(--color-flash-notice-bg); border:1px solid var(--color-flash-notice-border); border-radius:10px; padding:10px 16px; font-size:0.82rem; color:var(--color-flash-notice-text); margin-bottom:8px;" data-controller="flash">
            <div style="display:flex; align-items:center; justify-content:space-between;">
              <p style="margin:0;"><%= flash[:notice] %></p>
              <button data-action="click->flash#dismiss" aria-label="<%= t('layout.dismiss', default: 'Dismiss') %>" style="background:none; border:none; color:var(--color-flash-notice-text); cursor:pointer; padding:4px;">
                <%= svg_icon(:close, size: 14) %>
              </button>
            </div>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div role="alert" style="background:var(--color-flash-alert-bg); border:1px solid var(--color-flash-alert-border); border-radius:10px; padding:10px 16px; font-size:0.82rem; color:var(--color-flash-alert-text);" data-controller="flash">
            <div style="display:flex; align-items:center; justify-content:space-between;">
              <p style="margin:0;"><%= flash[:alert] %></p>
              <button data-action="click->flash#dismiss" aria-label="<%= t('layout.dismiss', default: 'Dismiss') %>" style="background:none; border:none; color:var(--color-flash-alert-text); cursor:pointer; padding:4px;">
                <%= svg_icon(:close, size: 14) %>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Main content %>
    <main id="main-content" style="height:100%;">
      <%= yield %>
    </main>

    <%# No bottom fade: it painted over the map's overlays (the Continue card,
        the bar); the map's own vignette frames the canvas. %>
  </body>
</html>
