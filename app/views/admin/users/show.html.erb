<% content_for(:title) { @detail.user.name } %><% content_for(:head) { stylesheet_link_tag "admin", "data-turbo-track": "reload" } %><% content_for(:full_width) { true } %>
<div class="admin-shell"><header class="admin-head"><div><div class="admin-kicker"><%= link_to t("admin.users.title"), admin_users_path, class: "admin-link" %></div><h1 class="admin-title"><%= @detail.user.name %></h1><p class="admin-sub"><%= @detail.user.email %> · <%= t("admin.fields.registered") %> <%= l(@detail.user.registered_at, format: :short) %> · <%= t("admin.fields.last_activity") %> <%= @detail.user.last_active_at ? l(@detail.user.last_active_at, format: :short) : t("admin.never") %></p></div><div><div class="admin-label"><%= t("admin.fields.cost") %></div><div class="admin-figure"><%= number_to_currency(@detail.user.cost_microcents / 1_000_000.0, precision: 4) %></div></div></header>
  <section class="admin-routes"><h2><%= t("admin.users.routes") %></h2><% @detail.routes.each do |route| %><article class="admin-card admin-route" data-route-id="<%= route.id %>"><div><span class="admin-state"><%= t("admin.states.#{route.state}") %> · <%= route.generation_state ? t("admin.generation.#{route.generation_state}") : t("admin.generation.unknown") %></span><h3><%= route.topic %></h3><p class="admin-sub"><%= t("admin.fields.progress") %>: <span class="admin-mono"><%= route.completed_steps %> / <%= route.total_steps %></span></p><div class="admin-progress"><span style="width:<%= route.total_steps.positive? ? (route.completed_steps * 100.0 / route.total_steps) : 0 %>%"></span></div><p><%= link_to t("admin.users.open_route"), learning_routes_engine.route_path(route.id), class: "admin-link" %></p></div><div><div class="admin-label"><%= t("admin.fields.cost") %></div><div class="admin-figure" data-route-cost><%= number_to_currency(route.cost_microcents / 1_000_000.0, precision: 4) %></div><span class="admin-state"><%= t(route.purchase_ready ? "admin.ready" : "admin.not_ready") %></span></div></article><% end %><% pages = (@detail.total_count.to_f / @detail.per_page).ceil %><nav class="admin-pagination" aria-label="<%= t('admin.pagination.label') %>"><span><%= t("admin.pagination.page", current: @detail.page, total: [pages, 1].max) %></span><span><% if @detail.page > 1 %><%= link_to t("admin.pagination.previous"), admin_user_path(@detail.user.id, request.query_parameters.merge(route_page: @detail.page - 1)), class: "admin-link" %><% end %> <% if @detail.page < pages %><%= link_to t("admin.pagination.next"), admin_user_path(@detail.user.id, request.query_parameters.merge(route_page: @detail.page + 1)), class: "admin-link" %><% end %></span></nav></section>
</div>
