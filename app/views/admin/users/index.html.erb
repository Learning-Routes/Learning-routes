<% content_for(:title) { t("admin.users.title") } %><% content_for(:head) { stylesheet_link_tag "admin", "data-turbo-track": "reload" } %><% content_for(:full_width) { true } %>
<div class="admin-shell">
  <header class="admin-head"><div><div class="admin-kicker"><%= link_to t("admin.dashboard.title"), admin_root_path, class: "admin-link" %></div><h1 class="admin-title"><%= t("admin.users.title") %></h1><p class="admin-sub"><%= t("admin.users.count", count: @result.total_count) %></p></div></header>
  <%= form_with url: admin_users_path, method: :get, class: "admin-toolbar", data: { turbo: false } do |form| %>
    <%= form.search_field :search, value: params[:search], placeholder: t("admin.users.search"), class: "admin-control", aria: { label: t("admin.users.search") } %>
    <%= form.select :activity, [[t("admin.filters.all_activity"), ""], [t("admin.filters.active"), "active"], [t("admin.filters.inactive"), "inactive"]], { selected: params[:activity] }, class: "admin-control" %>
    <%= form.select :route_state, [[t("admin.filters.all_routes"), ""]] + LearningRoutesEngine::LearningRoute.statuses.keys.map { |state| [t("admin.states.#{state}"), state] }, { selected: params[:route_state] }, class: "admin-control" %>
    <%= form.submit t("admin.users.apply"), class: "admin-control admin-button" %>
  <% end %>
  <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th><%= t("admin.fields.user") %></th><th><%= t("admin.fields.registered") %></th><th><%= t("admin.fields.last_activity") %></th><th><%= t("admin.fields.routes") %></th><th><%= t("admin.fields.progress") %></th><th><%= t("admin.fields.readiness") %></th><th><%= t("admin.fields.cost") %></th></tr></thead><tbody>
    <% @result.rows.each do |user| %><tr data-user-id="<%= user.id %>"><td><%= link_to user.name, admin_user_path(user.id), class: "admin-link admin-name" %><br><%= user.email %></td><td><%= l(user.registered_at, format: :short) %></td><td><%= user.last_active_at ? l(user.last_active_at, format: :short) : t("admin.never") %></td><td class="admin-mono"><%= user.route_count %></td><td><span class="admin-mono"><%= user.completed_steps %>/<%= user.total_steps %></span></td><td><span class="admin-state"><%= t(user.purchase_ready ? "admin.ready" : "admin.not_ready") %></span></td><td class="admin-mono"><%= number_to_currency(user.cost_microcents / 1_000_000.0, precision: 4) %><% if user.unpriced_interactions.positive? %><br><span class="admin-state" data-cost-status><%= t("admin.pricing_incomplete", count: user.unpriced_interactions) %></span><% end %></td></tr><% end %>
  </tbody></table></div>
  <%= render "admin/shared/pagination", result: @result %>
</div>
