<% pages = (result.total_count.to_f / result.per_page).ceil %><nav class="admin-pagination" aria-label="<%= t('admin.pagination.label') %>"><span><%= t("admin.pagination.page", current: result.page, total: [pages, 1].max) %></span><span><% if result.page > 1 %><%= link_to t("admin.pagination.previous"), admin_users_path(request.query_parameters.merge(page: result.page - 1)), class: "admin-link", data: { turbo: false } %><% end %> <% if result.page < pages %><%= link_to t("admin.pagination.next"), admin_users_path(request.query_parameters.merge(page: result.page + 1)), class: "admin-link", data: { turbo: false } %><% end %></span></nav>
