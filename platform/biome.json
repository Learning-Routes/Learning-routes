{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/worker-configuration.d.ts",
      "!**/test/golden/*.json",
      "!packages/ui-tokens/tokens.css",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "cloudflare:*",
                      "@cloudflare/*",
                      "hono",
                      "hono/*",
                      "react",
                      "react/*",
                      "react-dom",
                      "react-dom/*",
                      "react-router",
                      "react-router/*",
                      "drizzle-orm",
                      "drizzle-orm/*",
                      "pg",
                      "pg/*",
                      "postgres",
                      "@neondatabase/*",
                      "mysql2",
                      "mysql2/*",
                      "better-sqlite3",
                      "@libsql/*"
                    ],
                    "message": "packages/core holds the business rules and depends on no platform: no Cloudflare, Hono, React or database imports (docs/adr/0002-core-boundary.md)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
