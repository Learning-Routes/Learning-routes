{
  "name": "@learning-routes/platform",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "golden:check": "scripts/check-golden.sh",
    "knip": "knip",
    "deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "worker-size": "scripts/check-worker-size.mjs",
    "bench": "pnpm --filter @learning-routes/core bench",
    "fixtures": "node scripts/check-fixtures.mjs",
    "names": "node scripts/check-names.mjs",
    "shortcuts": "node scripts/check-shortcuts.mjs",
    "sizes": "node scripts/check-sizes.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "dependency-cruiser": "18.6.0",
    "knip": "6.41.0",
    "turbo": "2.11.8",
    "typescript": "5.9.3"
  }
}
