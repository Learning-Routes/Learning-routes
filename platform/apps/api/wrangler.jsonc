{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-routes-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  // pg needs Node's net and tls; Hyperdrive gives it a pooled Postgres connection.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The database is regional: run next to it (ADR 0005).
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
  "hyperdrive": [
    {
      "binding": "DB",
      // A placeholder until the owner creates the Hyperdrive config
      // (docs/runbooks/database.md); a dry-run deploy needs no real one.
      "id": "00000000000000000000000000000000",
      // LOCAL ONLY: the lr_app role of platform/docker-compose.yml, never the migrator.
      "localConnectionString": "postgres://lr_app:local-only-app@localhost:54318/learning_routes"
    }
  ]
}
