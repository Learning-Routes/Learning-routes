# Copy to .dev.vars (git-ignored) for wrangler dev. Never commit .dev.vars.
APP_ORIGIN=http://localhost:8787
# Development only: sign-in links are written to the Worker's log instead of mailed.
ENVIRONMENT=development
# Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The API token that purges the storefront's edge cache: permission Cache Purge, on the
# one zone. A local run never uses it, since purging is a no-op there; any value will do.
CLOUDFLARE_PURGE_TOKEN=
