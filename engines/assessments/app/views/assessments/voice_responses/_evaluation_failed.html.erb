<%# Evaluation Failed State (Turbo Stream replacement)
     locals: voice_response (VoiceResponse), error (String) %>

<div id="voice_evaluation_<%= voice_response.id %>"
     class="rounded-[14px] p-5"
     style="background: color-mix(in srgb, var(--color-txt) 8%, transparent); border: 1px solid color-mix(in srgb, var(--color-negative) 15%, transparent);">
  <div class="flex flex-col items-center gap-3 py-4">
    <%# Warning icon %>
    <div class="w-12 h-12 rounded-full flex items-center justify-center"
         style="background: color-mix(in srgb, var(--color-negative) 10%, transparent);">
      <svg class="w-6 h-6" style="color: var(--color-negative);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
      </svg>
    </div>

    <p class="text-sm font-medium" style="color: var(--color-negative); ">
      <%= t("voice_evaluation.error_evaluating") %>
    </p>

    <% if error.present? %>
      <p class="text-xs text-center max-w-xs" style="color: var(--color-faint); ">
        <%= error.to_s.truncate(120) %>
      </p>
    <% end %>

    <a href="" data-turbo-action="replace"
       class="mt-2 px-5 py-2.5 text-sm font-medium transition-all rounded-[11px] inline-block"
       style="color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 10%, transparent); text-decoration: none;">
      <%= t("voice_evaluation.retry") %>
    </a>
  </div>
</div>
