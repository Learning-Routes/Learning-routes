<% content_for(:title, t("assessments.exam.title_prefix") + @step.localized_title) %>

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8">
  <%# The controller wraps BOTH columns. It used to sit on `.flex-1` only, so the
      sidebar below was a SIBLING: `navItem` and `currentIndicator` were outside
      its scope entirely. `hasCurrentIndicatorTarget` was false, so `updateDisplay`
      no-opped and the counter was stuck at the server-rendered "0 de 4 respondidas"
      no matter how many answers saved; the squares never turned green; and the
      sidebar's number buttons were dead, because `goToQuestion` never fired. %>
  <div class="flex gap-6" data-controller="exam-timer question-nav"
         data-exam-timer-duration-seconds-value="<%= (@questions.count * 120).clamp(300, 3600) %>"
         data-question-nav-total-questions-value="<%= @questions.count %>"
         data-question-nav-saved-text-value="<%= t('assessments.exam.saved') %>"
         data-question-nav-save-text-value="<%= t('assessments.exam.save_answer') %>"
         data-question-nav-answered-template-value="<%= t('assessments.exam.answered_template') %>"
         data-question-nav-error-closed-value="<%= t('assessments.answers.no_attempt') %>"
         data-question-nav-error-forbidden-value="<%= t('assessments.exam.save_forbidden') %>"
         data-question-nav-error-network-value="<%= t('assessments.exam.save_network_error') %>"
         data-question-nav-error-generic-value="<%= t('assessments.exam.save_failed') %>"
         data-question-nav-error-partial-value="<%= t('assessments.exam.save_partial') %>">
    <!-- Questions area -->
    <div class="flex-1">
      <%# A refused save has to be legible. Before this the button simply never
          changed and nothing was logged, so every answer was thrown away in
          silence. %>
      <p data-question-nav-target="saveError" hidden
         role="status" aria-live="polite"
         style="margin:10px 0 0; padding:9px 14px; border-radius:9px; font-size:0.82rem;
                background:var(--color-flash-alert-bg, rgba(176,96,80,0.08));
                border:1px solid var(--color-flash-alert-border, rgba(176,96,80,0.15));
                color:var(--color-flash-alert-text, #B06050);
                font-family:'DM Sans',sans-serif;"></p>

      <!-- Header with timer -->
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-bold" style="color:var(--color-txt);"><%= @step.localized_title %></h1>
        <div class="flex items-center gap-2 rounded-lg px-3 py-1.5" style="background:var(--color-card); border:1px solid var(--color-border-subtle);">
          <svg aria-hidden="true" class="w-4 h-4" style="color:var(--color-sub);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span data-exam-timer-target="display" class="text-sm font-mono" style="color:var(--color-sub);">--:--</span>
        </div>
      </div>

      <!-- Questions form -->
      <%= form_with url: assessments.submit_result_path(@result), method: :post,
          data: { exam_timer_target: "form", action: "submit->question-nav#submitExam" }, local: true do |f| %>

        <% @questions.each_with_index do |question, index| %>
          <div data-question-nav-target="questionPanel"
               data-index="<%= index %>"
               class="<%= 'hidden' unless index == 0 %> rounded-xl p-6 mb-4"
               style="background:var(--color-card); border:1px solid var(--color-border-subtle);">

            <div class="flex items-center justify-between mb-4">
              <span class="text-xs" style="color:var(--color-muted);"><%= t("assessments.exam.question_of", current: index + 1, total: @questions.count) %></span>
              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium" style="background:var(--color-tint-strong); color:var(--color-sub);">
                <%= t("question_types.#{question.question_type}", default: question.question_type.humanize) %>
              </span>
            </div>

            <div class="lesson-content mb-6">
              <p style="color:var(--color-txt);"><%= question.body %></p>
            </div>

            <% case question.question_type %>
            <% when "multiple_choice" %>
              <%= render "learning_routes_engine/steps/question_multiple_choice", question: question, index: index %>
            <% when "short_answer" %>
              <%= render "learning_routes_engine/steps/question_short_answer", question: question, index: index %>
            <% when "code" %>
              <%= render "learning_routes_engine/steps/question_code", question: question, index: index %>
            <% end %>

            <!-- Auto-save individual answer -->
            <div class="mt-4 flex items-center justify-between">
              <div id="answer_feedback_<%= question.id %>"></div>
              <button type="button"
                      data-action="click->question-nav#saveAnswer"
                      data-question-nav-target="saveButton"
                      data-index="<%= index %>"
                      data-question-id="<%= question.id %>"
                      data-save-url="<%= assessments.assessment_answers_path(@assessment) %>"
                      class="text-xs transition"
                      style="color:var(--color-muted);">
                <%= t("assessments.exam.save_answer") %>
              </button>
            </div>
          </div>
        <% end %>

        <!-- Navigation + Submit -->
        <div class="flex items-center justify-between mt-6">
          <button type="button" data-action="click->question-nav#previous"
                  class="rounded-lg px-4 py-2.5 text-sm font-medium transition"
                  style="color:var(--color-sub); background:var(--color-tint-strong); border:1px solid var(--color-border-subtle);">
            <%= t("assessments.exam.previous") %>
          </button>

          <button type="button" data-action="click->question-nav#next"
                  class="rounded-lg px-4 py-2.5 text-sm font-medium transition"
                  style="color:var(--color-sub); background:var(--color-tint-strong); border:1px solid var(--color-border-subtle);">
            <%= t("assessments.exam.next") %>
          </button>
        </div>

        <div class="mt-6 text-center">
          <%= f.submit t("assessments.exam.submit"),
              class: "rounded-lg px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-indigo-500 to-purple-500 hover:from-indigo-400 hover:to-purple-400 transition cursor-pointer",
              data: { confirm: t("assessments.exam.confirm"),
                      question_nav_target: "submitButton" } %>
        </div>
      <% end %>
    </div>

    <!-- Question navigation sidebar -->
    <div class="hidden lg:block w-48 flex-shrink-0">
      <div class="sticky top-20 rounded-xl p-4" style="background:var(--color-card); border:1px solid var(--color-border-subtle);">
        <h3 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color:var(--color-sub);"><%= t("assessments.exam.sidebar_heading") %></h3>
        <div class="grid grid-cols-5 gap-2">
          <% @questions.each_with_index do |_q, index| %>
            <button data-action="click->question-nav#goToQuestion"
                    data-question-nav-target="navItem"
                    data-index="<%= index %>"
                    class="w-8 h-8 rounded-lg text-xs font-medium transition flex items-center justify-center"
                    style="background:var(--color-tint-strong); color:var(--color-sub);">
              <%= index + 1 %>
            </button>
          <% end %>
        </div>
        <div class="mt-3 text-xs" style="color:var(--color-muted);" data-question-nav-target="currentIndicator">
          <%= t("assessments.exam.answered", count: 0, total: @questions.count) %>
        </div>
      </div>
    </div>
  </div>
</div>
