<% if comment.errors.any? %>
  <div style="padding:0.7rem 0.85rem; border-radius:11px; background:var(--color-flash-alert-bg); border:1px solid var(--color-flash-alert-border); margin-bottom:0.75rem;">
    <% comment.errors.full_messages.each do |msg| %>
      <p style="font-size:0.78rem; font-weight:500; color:var(--color-flash-alert-text); margin:0;"><%= msg %></p>
    <% end %>
  </div>
<% end %>
