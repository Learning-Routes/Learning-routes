<div style="display:flex; flex-direction:column; gap:1rem;">
  <%# Share My Routes — button + modal %>
  <% if current_user %>
    <%
      # A join, not current_user.learning_profile: users are strict_loading.
      shareable_routes = LearningRoutesEngine::LearningRoute.active_routes
        .joins(:learning_profile)
        .where(learning_routes_engine_learning_profiles: { user_id: current_user.id })
        .includes(:route_steps).order(updated_at: :desc)
      already_shared_ids = CommunityEngine::SharedRoute.where(user_id: current_user.id).pluck(:learning_route_id)
      unshared_routes = shareable_routes.reject { |r| already_shared_ids.include?(r.id) }
    %>
    <div data-controller="share"
         data-share-url-value="<%= community_engine.shared_routes_path %>"
         data-share-route-id-value="">
      <button data-action="click->share#open" class="btn3" style="width:100%;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
          <polyline points="16 6 12 2 8 6"/>
          <line x1="12" y1="2" x2="12" y2="15"/>
        </svg>
        <%= t("community_engine.feed.sidebar.share_my_routes") %>
      </button>

      <%# Share modal (hidden by default) %>
      <div data-share-target="modal"
           style="display:none; position:fixed; inset:0; z-index:200; align-items:center; justify-content:center; padding:1rem;"
           data-action="click->share#backdropClick">
        <div style="position:absolute; inset:0; background:color-mix(in srgb, var(--color-bg) 70%, transparent); backdrop-filter:blur(4px); pointer-events:none;"></div>
        <div data-action="click->share#stopPropagation"
             style="position:relative; background:var(--color-card); border-radius:16px; width:100%; max-width:420px; max-height:80vh; overflow-y:auto;
                    box-shadow:0 24px 48px var(--color-shade);">
          <%# Header %>
          <div style="display:flex; align-items:center; justify-content:space-between; padding:1rem 1.25rem; border-bottom:1px solid var(--color-border-subtle);">
            <h3 style="font-weight:700; font-size:0.95rem; color:var(--color-txt); margin:0;">
              <%= t("community_engine.share_modal.title") %>
            </h3>
            <button data-action="click->share#close" style="color:var(--color-muted); background:none; border:none; cursor:pointer; padding:0.2rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>

          <%# Form view %>
          <div data-share-target="formView" style="padding:1rem 1.25rem;">
            <% if unshared_routes.any? %>
              <p style="font-size:0.75rem; font-weight:500; color:var(--color-sub); margin:0 0 0.5rem;">
                <%= t("community_engine.share_modal.select_route") %>
              </p>
              <div style="display:flex; flex-direction:column; gap:0.4rem; margin-bottom:1rem; max-height:180px; overflow-y:auto;">
                <% unshared_routes.each do |route| %>
                  <button type="button"
                          data-action="click->share#selectRoute"
                          data-share-target="routeSelect"
                          data-route-id="<%= route.id %>"
                          style="display:flex; align-items:center; gap:0.5rem; padding:0.55rem 0.75rem; border-radius:10px;
                                 border:1px solid var(--color-border-subtle); background:transparent; cursor:pointer; transition:all 0.15s; text-align:left;">
                    <div style="width:28px; height:28px; border-radius:7px; background:var(--color-accent-soft); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--color-progress-bar)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
                    </div>
                    <div style="flex:1; min-width:0;">
                      <p style="font-size:0.78rem; font-weight:500; color:var(--color-txt); margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                        <%= route.localized_topic %>
                      </p>
                      <p class="font-mono" style="font-size:0.58rem; color:var(--color-muted); margin:0.1rem 0 0;">
                        <%= route.route_steps.size %> <%= t("community_engine.share_modal.steps") %>
                      </p>
                    </div>
                  </button>
                <% end %>
              </div>
            <% else %>
              <p style="font-size:0.78rem; color:var(--color-muted); text-align:center; padding:0.75rem 0; margin:0 0 0.75rem;">
                <%= t("community_engine.share_modal.all_shared") %>
              </p>
            <% end %>

            <%# Visibility selector %>
            <p style="font-size:0.75rem; font-weight:500; color:var(--color-sub); margin:0 0 0.4rem;">
              <%= t("community_engine.share_modal.visibility_label") %>
            </p>
            <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.35rem; margin-bottom:0.85rem;">
              <% [
                ["public", t("community_engine.share_modal.visibility.public"), t("community_engine.share_modal.visibility.public_desc")],
                ["unlisted", t("community_engine.share_modal.visibility.unlisted"), t("community_engine.share_modal.visibility.unlisted_desc")],
                ["private", t("community_engine.share_modal.visibility.private"), t("community_engine.share_modal.visibility.private_desc")]
              ].each do |value, label, desc| %>
                <button type="button"
                        data-action="click->share#selectVisibility"
                        data-share-target="visibilityBtn"
                        data-visibility="<%= value %>"
                        style="padding:0.5rem 0.4rem; border-radius:10px; border:1px solid <%= value == 'public' ? 'var(--color-accent)' : 'var(--color-faint)' %>;
                               background:<%= value == 'public' ? 'var(--color-accent-soft)' : 'transparent' %>;
                               cursor:pointer; text-align:center; transition:all 0.15s;">
                  <span style="display:block; font-size:0.72rem; font-weight:500; color:var(--color-txt);"><%= label %></span>
                  <span class="font-mono" style="display:block; font-size:0.52rem; color:var(--color-muted); margin-top:0.15rem;"><%= desc %></span>
                </button>
              <% end %>
            </div>

            <%# Description %>
            <textarea data-share-target="description" class="input3"
                      placeholder="<%= t('community_engine.share_modal.description_placeholder') %>"
                      rows="2"
                      style="width:100%; height:auto; padding:0.6rem 0.8rem; resize:none; margin-bottom:0.85rem;"></textarea>

            <% if unshared_routes.any? %>
              <button data-action="click->share#submit"
                      data-share-target="submitBtn" class="btn3" style="width:100%;">
                <%= t("community_engine.share_modal.share_btn") %>
              </button>
            <% end %>
          </div>

          <%# Success view %>
          <div data-share-target="successView" style="display:none; padding:1.25rem; text-align:center;">
            <div style="width:42px; height:42px; margin:0 auto 0.65rem; border-radius:50%; background:var(--color-positive-bg);
                        display:flex; align-items:center; justify-content:center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-positive)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <p style="font-size:0.82rem; font-weight:500; color:var(--color-txt); margin:0 0 0.85rem;">
              <%= t("community_engine.share_modal.success") %>
            </p>
            <div style="display:flex; align-items:center; gap:0.4rem; margin-bottom:0.85rem;">
              <input class="input3 font-mono" type="text" data-share-target="urlField" readonly style="flex:1; font-size:0.75rem;">
              <button data-action="click->share#copyUrl" data-share-target="copyBtn" class="btn3 btn3--sm" style="flex-shrink:0;">
                <%= t("community_engine.share_modal.copy") %>
              </button>
            </div>
            <button data-action="click->share#close" class="btn3 btn3--secondary" style="width:100%;">
              <%= t("community_engine.share_modal.done") %>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Top learners %>
  <% followed_ids = current_user ? CommunityEngine::Follow.where(follower_id: current_user.id).pluck(:followed_id).to_set : Set.new %>
  <div class="card3" style="padding:1rem;">
    <h3 style="font-weight:700; font-size:0.78rem; color:var(--color-txt); margin:0 0 0.75rem;">
      <%= t("community_engine.feed.sidebar.top_learners") %>
    </h3>
    <% if @top_learners.any? %>
      <div style="display:flex; flex-direction:column; gap:0.55rem;">
        <% @top_learners.each_with_index do |learner, i| %>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <span class="font-mono" style="width:16px; text-align:right; font-size:0.58rem; font-weight:700; color:var(--color-muted);">
              <%= i + 1 %>
            </span>
            <div style="width:26px; height:26px; border-radius:50%; background:var(--color-accent);
                        display:flex; align-items:center; justify-content:center; color:var(--color-accent-text);
                        font-size:0.55rem; font-weight:700; flex-shrink:0;">
              <%= learner.name.to_s.first&.upcase || "?" %>
            </div>
            <div style="flex:1; min-width:0;">
              <p style="font-size:0.78rem; font-weight:500; color:var(--color-txt); margin:0;
                        overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                <%= learner.name %>
              </p>
            </div>
            <% if current_user && learner.id != current_user.id %>
              <% if followed_ids.include?(learner.id) %>
                <span class="font-mono" style="font-size:0.55rem; color:var(--color-muted); padding:0.15rem 0.4rem; border-radius:5px;
                             background:var(--color-faint);">
                  <%= t("community_engine.follows.following") %>
                </span>
              <% else %>
                <%= render "community_engine/follows/button", user: learner, following: false %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p style="font-size:0.72rem; color:var(--color-muted); text-align:center; padding:0.75rem 0;">
        <%= t("community_engine.feed.sidebar.no_learners") %>
      </p>
    <% end %>
  </div>

  <%# Platform stats %>
  <div class="card3" style="padding:1rem;">
    <h3 style="font-weight:700; font-size:0.78rem; color:var(--color-txt); margin:0 0 0.65rem;">
      <%= t("community_engine.feed.sidebar.platform_stats") %>
    </h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem;">
      <% [
        [t("community_engine.feed.stats.learners"), @stats[:total_users]],
        [t("community_engine.feed.stats.routes"), @stats[:total_routes]],
        [t("community_engine.feed.stats.shared"), @stats[:total_shared]]
      ].each do |label, value| %>
        <div style="display:flex; align-items:center; justify-content:space-between;">
          <span style="font-size:0.72rem; color:var(--color-sub);"><%= label %></span>
          <span class="font-mono" style="font-size:0.78rem; font-weight:700; color:var(--color-txt);"><%= value %></span>
        </div>
      <% end %>
    </div>
  </div>

  <%# Suggested follows %>
  <% if current_user %>
    <%
      suggested = Core::User.where.not(id: current_user.id)
        .where.not(id: current_user.following.select(:id))
        .order(Arel.sql("RANDOM()"))
        .limit(3)
    %>
    <% if suggested.any? %>
      <div class="card3" style="padding:1rem;">
        <h3 style="font-weight:700; font-size:0.78rem; color:var(--color-txt); margin:0 0 0.65rem;">
          <%= t("community_engine.feed.sidebar.suggested") %>
        </h3>
        <div style="display:flex; flex-direction:column; gap:0.55rem;">
          <% suggested.each do |user| %>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <div style="width:26px; height:26px; border-radius:50%; background:var(--color-accent);
                          display:flex; align-items:center; justify-content:center; color:var(--color-accent-text);
                          font-size:0.55rem; font-weight:700; flex-shrink:0;">
                <%= user.name.to_s.first&.upcase || "?" %>
              </div>
              <div style="flex:1; min-width:0;">
                <p style="font-size:0.78rem; font-weight:500; color:var(--color-txt); margin:0;
                          overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                  <%= user.name %>
                </p>
              </div>
              <%= render "community_engine/follows/button", user: user, following: false %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
