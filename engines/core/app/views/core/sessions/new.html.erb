<% content_for(:title, t("auth.login.title")) %>

<% content_for(:head) { render "shared/public_head", description: t("auth.login.meta_description") } %>

<% content_for(:auth_toggle) do %>
  <%= link_to core.sign_up_path,
      style: "font-size:0.82rem; color:var(--color-muted); text-decoration:none; transition:color 0.2s;",
      class: "nav-link" do %>
    <%= t("auth.login.toggle") %>
  <% end %>
<% end %>

<%# === Glassmorphic auth card === %>
<div class="auth-enter auth-card card3"
     style="width:100%; max-width:440px; padding:2.2rem 2rem;">

  <%# === Heading === %>
  <h1 style="font-weight:700; font-size:1.6rem; letter-spacing:-0.7px; color:var(--color-txt); margin:0 0 1.5rem; line-height:1.2;">
    <%= t("auth.login.heading") %>
  </h1>

  <%# === Google OAuth — plain HTML form, no Stimulus === %>
  <% if google_oauth_enabled? %>
    <form action="/auth/google_oauth2" method="post" data-turbo="false">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <button type="submit"
              aria-label="<%= t('auth.login.google') %>"
              class="auth-google-btn"
              style="display:flex; align-items:center; justify-content:center; gap:0.65rem; width:100%;
                     font-size:0.88rem; font-weight:500;
                     padding:0.78rem 1rem; border-radius:11px;
                     cursor:pointer; transition:all 0.2s;">
        <%= render "core/shared/google_logo" %>
        <%= t("auth.login.google") %>
      </button>
    </form>
  <% end %>

  <%# === Divider === %>
  <div style="display:flex; align-items:center; gap:0.8rem; margin:1.4rem 0;" role="presentation">
    <div style="flex:1; height:1px; background:var(--color-faint);"></div>
    <span class="font-mono" style="font-size:0.55rem; letter-spacing:2px; text-transform:uppercase; color:var(--color-muted);"><%= t("auth.login.divider") %></span>
    <div style="flex:1; height:1px; background:var(--color-faint);"></div>
  </div>

  <%# === Login form — with Stimulus validation === %>
  <div data-controller="auth-form"
       data-auth-form-required-msg-value="<%= t('auth_alerts.validation_required') %>"
       data-auth-form-email-msg-value="<%= t('auth_alerts.validation_email') %>"
       data-auth-form-min-length-msg-value="<%= t('auth_alerts.validation_min_length') %>">
    <%= form_with(url: core.sign_in_path, data: { turbo: false }) do |f| %>

      <div style="display:flex; flex-direction:column; gap:1rem;">

        <%# Email %>
        <div>
          <%= f.label :email, t("auth.login.email_label"),
              style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
          <%= f.email_field :email,
              class: "auth-input",
              style: "display:block; width:100%; box-sizing:border-box; font-size:0.92rem; padding:0.78rem 0.95rem; transition:border-color 0.2s, box-shadow 0.2s;",
              placeholder: t("auth.login.email_placeholder"),
              required: true,
              autofocus: true,
              autocomplete: "email",
              data: { auth_form_target: "input", action: "focus->auth-form#inputFocus blur->auth-form#inputBlur" } %>
        </div>

        <%# Password %>
        <div>
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.45rem;">
            <%= f.label :password, t("auth.login.password_label"),
                style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin:0;" %>
            <%= link_to t("auth.login.forgot"), core.forgot_password_path,
                style: "font-size:0.72rem; color:var(--color-muted); text-decoration:none; transition:color 0.2s;" %>
          </div>
          <%= f.password_field :password,
              class: "auth-input",
              style: "display:block; width:100%; box-sizing:border-box; font-size:0.92rem; padding:0.78rem 0.95rem; transition:border-color 0.2s, box-shadow 0.2s;",
              placeholder: t("auth.login.password_placeholder"),
              required: true,
              autocomplete: "current-password",
              data: { auth_form_target: "input", action: "focus->auth-form#inputFocus blur->auth-form#inputBlur" } %>
        </div>

        <%# Remember me %>
        <label style="display:flex; align-items:center; gap:0.55rem; cursor:pointer; font-size:0.82rem; color:var(--color-sub); user-select:none;">
          <%= f.check_box :remember_me,
              { checked: false,
                style: "width:1rem; height:1rem; cursor:pointer; accent-color:var(--color-accent);" },
              "1", "0" %>
          <%= t("auth.login.remember_me") %>
        </label>

        <%# Submit %>
        <div style="margin-top:0.3rem;">
          <%= f.submit t("auth.login.submit"),
              class: "btn3 w-full",
              data: { auth_form_target: "submit" } %>
        </div>
      </div>
    <% end %>
  </div>

  <%# === Switch to register === %>
  <p style="text-align:center; margin:1.3rem 0 0; font-size:0.78rem; color:var(--color-muted);">
    <%= t("auth.login.switch_text") %>
    <%= link_to t("auth.login.switch_link"), core.sign_up_path,
        style: "color:var(--color-link); text-decoration:none; font-weight:600;" %>
  </p>

</div>
