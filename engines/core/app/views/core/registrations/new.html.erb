<% content_for(:title, t("auth.register.title")) %>

<% content_for(:head) { render "shared/public_head", description: t("auth.register.meta_description") } %>

<% content_for(:auth_toggle) do %>
  <%= link_to core.sign_in_path,
      style: "font-size:0.82rem; color:var(--color-muted); text-decoration:none; transition:color 0.2s;",
      class: "nav-link" do %>
    <%= t("auth.register.toggle") %>
  <% end %>
<% end %>

<%# Wrapper to stack card + legal vertically %>
<div style="display:flex; flex-direction:column; align-items:center; width:100%; max-width:440px;">

  <%# === Glassmorphic auth card === %>
  <div class="auth-enter auth-card card3"
       style="width:100%; padding:2.2rem 2rem;">

    <%# === Heading === %>
    <h1 style="font-weight:700; font-size:1.6rem; letter-spacing:-0.7px; color:var(--color-txt); margin:0 0 1.5rem; line-height:1.2;">
      <%= t("auth.register.heading") %>
    </h1>

    <%# === Google OAuth — plain HTML form, no Stimulus === %>
    <% if google_oauth_enabled? %>
      <form action="/auth/google_oauth2" method="post" data-turbo="false">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit"
                aria-label="<%= t('auth.register.google') %>"
                class="auth-google-btn"
                style="display:flex; align-items:center; justify-content:center; gap:0.65rem; width:100%;
                       font-size:0.88rem; font-weight:500;
                       padding:0.78rem 1rem; border-radius:11px;
                       cursor:pointer; transition:all 0.2s;">
          <%= render "core/shared/google_logo" %>
          <%= t("auth.register.google") %>
        </button>
      </form>
    <% end %>

    <%# === Divider === %>
    <div style="display:flex; align-items:center; gap:0.8rem; margin:1.4rem 0;" role="presentation">
      <div style="flex:1; height:1px; background:var(--color-faint);"></div>
      <span class="font-mono" style="font-size:0.55rem; letter-spacing:2px; text-transform:uppercase; color:var(--color-muted);"><%= t("auth.register.divider") %></span>
      <div style="flex:1; height:1px; background:var(--color-faint);"></div>
    </div>

    <%# === Registration form — with Stimulus validation === %>
    <div data-controller="auth-form"
         data-auth-form-required-msg-value="<%= t('auth_alerts.validation_required') %>"
         data-auth-form-email-msg-value="<%= t('auth_alerts.validation_email') %>"
         data-auth-form-min-length-msg-value="<%= t('auth_alerts.validation_min_length') %>">
      <%# Only the bare POST route exists; the language travels in the cookie (STEP 36 §2). %>
      <%= form_with(model: @user, url: core.sign_up_path(locale: nil)) do |f| %>

        <%# Form errors %>
        <% if @user.errors.any? %>
          <div role="alert" class="auth-errors" style="background:var(--color-flash-alert-bg); border:1px solid var(--color-flash-alert-border); border-radius:10px; padding:0.75rem 0.9rem; margin-bottom:1rem; color:var(--color-flash-alert-text);">
            <p style="font-size:0.76rem; font-weight:500; color:inherit; margin:0 0 0.3rem;">
              <%= t("auth.register.errors", count: @user.errors.count) %>
            </p>
            <ul style="margin:0; padding-left:1rem;">
              <% @user.errors.full_messages.each do |message| %>
                <li style="font-size:0.72rem; color:inherit; line-height:1.5;"><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div style="display:flex; flex-direction:column; gap:1rem;">

          <%# Name %>
          <div>
            <%= f.label :name, t("auth.register.name_label"),
                style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
            <%= f.text_field :name,
                class: "auth-input",
                style: "display:block; width:100%; box-sizing:border-box; font-size:0.92rem; padding:0.78rem 0.95rem; transition:border-color 0.2s, box-shadow 0.2s;",
                placeholder: t("auth.register.name_placeholder"),
                required: true,
                autofocus: true,
                autocomplete: "name",
                data: { auth_form_target: "input", action: "focus->auth-form#inputFocus blur->auth-form#inputBlur" } %>
          </div>

          <%# Email %>
          <div>
            <%= f.label :email, t("auth.register.email_label"),
                style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
            <%= f.email_field :email,
                class: "auth-input",
                style: "display:block; width:100%; box-sizing:border-box; font-size:0.92rem; padding:0.78rem 0.95rem; transition:border-color 0.2s, box-shadow 0.2s;",
                placeholder: t("auth.register.email_placeholder"),
                required: true,
                autocomplete: "email",
                data: { auth_form_target: "input", action: "focus->auth-form#inputFocus blur->auth-form#inputBlur" } %>
          </div>

          <%# Password %>
          <div>
            <%= f.label :password, t("auth.register.password_label"),
                style: "display:block; font-size:0.78rem; font-weight:500; color:var(--color-sub); margin-bottom:0.45rem;" %>
            <%= f.password_field :password,
                class: "auth-input",
                style: "display:block; width:100%; box-sizing:border-box; font-size:0.92rem; padding:0.78rem 0.95rem; transition:border-color 0.2s, box-shadow 0.2s;",
                placeholder: t("auth.register.password_placeholder"),
                required: true,
                minlength: 8,
                autocomplete: "new-password",
                data: { auth_form_target: "input", action: "focus->auth-form#inputFocus blur->auth-form#inputBlur" } %>
          </div>

          <%# Submit %>
          <div style="margin-top:0.3rem;">
            <%= f.submit t("auth.register.submit"),
                class: "btn3 w-full",
                data: { auth_form_target: "submit" } %>
          </div>
        </div>
      <% end %>
    </div>

    <%# === Switch to login === %>
    <p style="text-align:center; margin:1.3rem 0 0; font-size:0.78rem; color:var(--color-muted);">
      <%= t("auth.register.switch_text") %>
      <%= link_to t("auth.register.switch_link"), core.sign_in_path,
          style: "color:var(--color-link); text-decoration:none; font-weight:600;" %>
    </p>

  </div>

  <%# === Legal (below card) === %>
  <p style="text-align:center; font-size:0.62rem; color:var(--color-muted); line-height:1.5; margin:1rem 0 0;">
    <%= t("auth.register.legal_html", terms_url: main_app.terms_path, privacy_url: main_app.privacy_path) %>
  </p>

</div>
