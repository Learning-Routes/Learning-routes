<%# Tutor Chat Slide-Over Panel %>
<%# THE SUBSCRIPTION. TutorReplyJob broadcasts every reply to this stream and
    nothing had ever subscribed to it, so answers were written to `tutor_messages`
    and delivered to nobody (WP-35 §1). It sits INSIDE the panel deliberately: the
    subscription must live and die with the element, or a Turbo navigation leaves
    a stream open against a step the student has left. %>
<%= turbo_stream_from "tutor_chat_step_#{step.id}" %>
<%
  tutor_i18n = {
    send_forbidden: t("tutor.send_forbidden"),
    send_rate_limited: t("tutor.send_rate_limited"),
    send_failed: t("tutor.send_failed")
  }
%>
<div data-controller="tutor-chat"
     data-tutor-chat-step-id-value="<%= step.id %>"
     data-tutor-chat-url-value="<%= learning_routes_engine.route_step_tutor_chats_path(step.learning_route, step) %>"
     data-tutor-chat-i18n-value="<%= tutor_i18n.to_json %>"
     id="tutor-chat-container">

  <!-- FAB Button -->
  <button data-tutor-chat-target="fab"
          data-action="click->tutor-chat#toggle"
          class="fixed bottom-4 right-4 z-50 w-14 h-14 rounded-full shadow-lg flex items-center justify-center transition-all duration-200 hover:scale-105 active:scale-95"
          style="background: var(--color-txt); color: var(--color-bg);"
          aria-label="<%= t("tutor.open") %>">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    <!-- Proactive badge -->
    <span data-tutor-chat-target="badge"
          class="absolute -top-1 -right-1 hidden px-2 py-0.5 rounded-full text-xs font-bold"
          style="background: var(--color-error); color: var(--color-bg); font-size: 10px;">
    </span>
  </button>

  <!-- Slide-over panel -->
  <div data-tutor-chat-target="panel"
       class="fixed top-0 right-0 bottom-0 z-50 flex flex-col shadow-2xl"
       style="width: 380px; max-width: 100vw; background: var(--color-card); transform: translateX(100%); transition: transform 0.2s ease;"
       role="dialog"
       aria-label="<%= t("tutor.title") %>">

    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 shrink-0" style="background: var(--color-txt); color: var(--color-bg);">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm" style="background: var(--color-tint-strong);">🤖</div>
        <div>
          <p class="text-sm font-bold"><%= t("tutor.title") %></p>
          <p class="text-xs" style="color: var(--color-muted);"><%= t("tutor.subtitle") %></p>
        </div>
      </div>
      <button data-action="click->tutor-chat#toggle"
              class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors"
              style="background: var(--color-tint-strong);"
              aria-label="<%= t("tutor.close") %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Messages area -->
    <div data-tutor-chat-target="messages"
         id="tutor-messages-<%= step.id %>"
         class="flex-1 overflow-y-auto px-4 py-3 space-y-3"
         style="scroll-behavior: smooth;">
      <!-- Greeting message -->
      <div class="flex gap-2">
        <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs shrink-0" style="background: var(--color-tint-strong);">🤖</div>
        <div class="px-3 py-2 rounded-2xl rounded-tl-sm text-sm" style="background: var(--color-tint); color: var(--color-txt); max-width: 85%;">
          <%= t("tutor.greeting") %>
        </div>
      </div>

      <%# The transcript. `tutor_chats#index` has always been able to render this
          and nothing ever called it, so a reload lost the conversation from view
          while every message sat in the database. %>
      <%= render "learning_routes_engine/tutor_chats/messages",
                 messages: LearningRoutesEngine::TutorMessage
                             .where(user: current_user, step: step)
                             .order(created_at: :asc).last(20) %>
    </div>

    <%# Where a refused or failed send says so. `send()` used to check
        `response.ok` with no `else`, so a 403 from the generation gate or a 429
        left the skeleton pulsing forever and said nothing. %>
    <div data-tutor-chat-target="error"
         class="px-4 pt-2 text-xs hidden"
         role="status" aria-live="polite"
         style="color: var(--color-error);"></div>

    <!-- Input area -->
    <div class="px-4 py-3 shrink-0" style="border-top: 1px solid var(--color-border-subtle);">
      <div class="flex gap-2">
        <input type="text"
               data-tutor-chat-target="input"
               data-action="keydown.enter->tutor-chat#send"
               class="flex-1 px-4 py-2 rounded-xl text-sm"
               style="background: var(--color-tint); border: 1px solid var(--color-border-subtle); color: var(--color-txt); outline: none;"
               placeholder="<%= t("tutor.placeholder") %>"
               autocomplete="off">
        <button data-action="click->tutor-chat#send"
                data-tutor-chat-target="sendBtn"
                class="px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200"
                style="background: var(--color-txt); color: var(--color-bg);"
                aria-label="<%= t("tutor.send") %>">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Backdrop -->
  <div data-tutor-chat-target="backdrop"
       data-action="click->tutor-chat#toggle"
       class="fixed inset-0 z-40 hidden"
       style="background: rgba(0,0,0,0.3);"></div>
</div>
