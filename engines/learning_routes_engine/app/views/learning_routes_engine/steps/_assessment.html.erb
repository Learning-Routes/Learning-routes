<div style="max-width:var(--step-measure); margin:0 auto; padding:1rem;">
  <%# Header %>
  <div style="margin-bottom:2rem;">
    <span class="lesson-section-badge" style="background:linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 12%, transparent), color-mix(in srgb, var(--color-accent) 6%, transparent)); color:var(--color-section-audio-active); border:1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
      <span><%= @step.metadata&.dig('assessment_type') ? t("assessment_types.#{@step.metadata.dig('assessment_type')}", default: @step.metadata.dig('assessment_type').humanize) : t('learning_engine.assessment.badge') %></span>
    </span>
    <h1 style="font-size:1.75rem; font-weight:800; color:var(--color-txt); margin:0.875rem 0 0; letter-spacing:-0.5px; line-height:1.25;"><%= @step.localized_title %></h1>
    <% if @step.localized_description.present? %>
      <p style="font-size:0.9375rem; color:var(--color-sub); margin:0.5rem 0 0; line-height:1.5;"><%= @step.localized_description %></p>
    <% end %>
  </div>

  <% if @assessment_generating %>
    <%= render "loading_skeleton" %>
  <% elsif @assessment %>
    <% if @existing_result&.score.present? %>
      <%# Already completed - show results summary %>
      <div style="background:var(--color-card); border:1px solid var(--color-border-subtle); border-radius:16px; padding:2rem; text-align:center; box-shadow:0 1px 3px color-mix(in srgb, var(--color-shade) 11%, transparent), 0 4px 16px color-mix(in srgb, var(--color-shade) 6%, transparent);">
        <%# Score ring %>
        <div style="position:relative; width:6rem; height:6rem; margin:0 auto 1.25rem;">
          <% score = @existing_result.score.round(1) %>
          <% score_color = @existing_result.passed? ? 'var(--color-positive)' : 'var(--color-negative)' %>
          <svg width="96" height="96" viewBox="0 0 96 96" style="transform:rotate(-90deg);">
            <circle cx="48" cy="48" r="42" fill="none" stroke="color-mix(in srgb, var(--color-txt) 8%, transparent)" stroke-width="6"/>
            <circle cx="48" cy="48" r="42" fill="none" stroke="<%= score_color %>" stroke-width="6"
                    stroke-linecap="round"
                    stroke-dasharray="<%= (263.89 * score / 100.0).round(1) %> 263.89"
                    style="transition:stroke-dasharray 1s cubic-bezier(0.34,1.56,0.64,1);"/>
          </svg>
          <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center;">
            <span style="font-size:1.5rem; font-weight:800; color:<%= score_color %>; letter-spacing:-0.5px;"><%= score %>%</span>
          </div>
        </div>

        <p style="font-size:0.9375rem; font-weight:500; color:var(--color-sub); margin:0 0 1.5rem;">
          <%= @existing_result.passed? ? t('learning_engine.assessment.passed') : t('learning_engine.assessment.not_passed') %>
          <span style="color:var(--color-muted);">(<%= t('learning_engine.assessment.passing') %> <%= @assessment.passing_score %>%)</span>
        </p>

        <%= link_to t('learning_engine.assessment.view_results'), assessments.result_path(@existing_result),
            style: "display:inline-flex; align-items:center; gap:0.5rem; border-radius:14px; padding:0.75rem 1.75rem; font-size:0.9375rem; font-weight:600; color:var(--color-accent-text); text-decoration:none; background:linear-gradient(135deg, var(--color-section-audio-active), var(--color-accent)); transition:all 0.25s; box-shadow:0 4px 12px color-mix(in srgb, var(--color-accent) 25%, transparent);" %>

        <%# THE RETAKE. This branch used to end here, and the only Start button in
            this partial lived in the `else` below — so a student who had been
            scored once saw "No superado" and no way to try again, forever. That
            is what made RELEASE_AFTER unreachable and left the header's
            "Completar paso" as the only way forward (WP-32 §1, §2).

            Shown whenever the step is not completed, whatever the score: a
            student who passed may still want another run, and one who failed
            must be able to. A COMPLETED step shows nothing — there is nothing
            left to earn. %>
        <% unless @step.completed? %>
          <div style="margin-top:1.5rem; padding-top:1.5rem; border-top:1px solid var(--color-border-subtle);">
            <%= button_to t('learning_engine.assessment.retake'), assessments.start_assessment_path(@assessment),
                method: :post,
                style: "width:100%; border-radius:14px; padding:0.875rem 1rem; font-size:0.9375rem; font-weight:600; color:var(--color-txt); border:1px solid var(--color-border-subtle); cursor:pointer; background:color-mix(in srgb, var(--color-txt) 4%, transparent); transition:all 0.25s;" %>
            <% if @assessment_decision&.blocked? %>
              <p style="font-size:0.8125rem; color:var(--color-muted); margin:0.75rem 0 0;">
                <%= t('learning_engine.assessment.attempts_left', count: @assessment_decision.attempts_left) %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Start assessment %>
      <div style="background:var(--color-card); border:1px solid var(--color-border-subtle); border-radius:16px; padding:2rem; box-shadow:0 1px 3px color-mix(in srgb, var(--color-shade) 11%, transparent), 0 4px 16px color-mix(in srgb, var(--color-shade) 6%, transparent);">
        <%# Stats grid %>
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:1rem; margin-bottom:2rem;">
          <div style="text-align:center; padding:1rem; background:color-mix(in srgb, var(--color-txt) 4%, transparent); border-radius:14px;">
            <div style="display:flex; align-items:center; justify-content:center; width:2.5rem; height:2.5rem; border-radius:12px; background:color-mix(in srgb, var(--color-accent) 8%, transparent); margin:0 auto 0.625rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-section-audio-active)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div style="font-size:1.5rem; font-weight:800; color:var(--color-txt); letter-spacing:-0.5px;"><%= @assessment.questions.count %></div>
            <div class="font-mono" style="font-size:0.625rem; font-weight:500; color:var(--color-muted); text-transform:uppercase; letter-spacing:0.08em; margin-top:0.25rem;"><%= t('learning_engine.assessment.questions') %></div>
          </div>
          <div style="text-align:center; padding:1rem; background:color-mix(in srgb, var(--color-txt) 4%, transparent); border-radius:14px;">
            <div style="display:flex; align-items:center; justify-content:center; width:2.5rem; height:2.5rem; border-radius:12px; background:color-mix(in srgb, var(--color-positive) 8%, transparent); margin:0 auto 0.625rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-positive)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div style="font-size:1.5rem; font-weight:800; color:var(--color-txt); letter-spacing:-0.5px;"><%= @assessment.passing_score.to_i %>%</div>
            <div class="font-mono" style="font-size:0.625rem; font-weight:500; color:var(--color-muted); text-transform:uppercase; letter-spacing:0.08em; margin-top:0.25rem;"><%= t('learning_engine.assessment.passing_score') %></div>
          </div>
          <div style="text-align:center; padding:1rem; background:color-mix(in srgb, var(--color-txt) 4%, transparent); border-radius:14px;">
            <div style="display:flex; align-items:center; justify-content:center; width:2.5rem; height:2.5rem; border-radius:12px; background:color-mix(in srgb, var(--color-highlight) 8%, transparent); margin:0 auto 0.625rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-warning)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div style="font-size:1.5rem; font-weight:800; color:var(--color-txt); letter-spacing:-0.5px;">~<%= (@assessment.questions.count * 2).clamp(5, 60) %></div>
            <div class="font-mono" style="font-size:0.625rem; font-weight:500; color:var(--color-muted); text-transform:uppercase; letter-spacing:0.08em; margin-top:0.25rem;"><%= t('learning_engine.assessment.minutes') %></div>
          </div>
        </div>

        <%= button_to t('learning_engine.assessment.start'), assessments.start_assessment_path(@assessment),
            method: :post, class: "btn3", style: "width:100%;" %>
      </div>
    <% end %>
  <% else %>
    <div style="text-align:center; padding:3rem 1rem;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 1rem; display:block; opacity:0.5;"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
      <p style="font-size:0.9375rem; color:var(--color-muted);"><%= t('learning_engine.assessment.not_generated') %></p>
    </div>
  <% end %>
</div>
