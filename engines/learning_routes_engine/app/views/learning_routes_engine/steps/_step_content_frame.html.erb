<% generating = @content_generating || @assessment_generating %>
<turbo-frame id="step_content_<%= @step.id %>" target="_top"
  <%# Do NOT poll while in the failed state: the poll endpoint re-runs
      load_step_content, and polling a permanently-failed step every 3s is how the
      re-enqueue loop stayed invisible. %>
  <% if generating && !@content_failed && !@content_unavailable %>
    data-controller="content-poll"
    data-content-poll-url-value="<%= content_status_route_step_path(@route, @step) %>"
    data-content-poll-interval-value="3000"
  <% end %>
>
  <% if @content_unavailable %>
    <%= render "content_unavailable" %>
  <% elsif @content_failed %>
    <%= render "content_failed" %>
  <% elsif @step.delivery_format == "audio" && @content&.audio_ready? %>
    <%= render "content_engine/audio/audio_lesson", step: @step, content: @content %>
  <% else %>
    <%# Text lesson fallback (also used when audio is generating/failed) %>
    <% case @step.content_type %>
    <%# An exercise renders through the lesson machinery: same parser, same
        blocks, same gate. `_exercise.html.erb` drew `@rendered_html` flat and
        then an Ace editor whose language was hardcoded to JavaScript, so every
        exercise in every subject was a JavaScript editor and none of its real
        blocks were ever drawn (WP-35 §3). The badge in `_lesson` distinguishes
        the two. %>
    <% when "lesson", "exercise" %>
      <%= render "lesson" %>
    <% when "assessment" %>
      <%= render "assessment" %>
    <% when "review" %>
      <%= render "review" %>
    <% end %>
  <% end %>
</turbo-frame>
