{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-routes-web",
  "compatibility_date": "2026-10-12",
  "main": "./workers/app.ts",
  // Reached only through its own hosts: no workers.dev address, and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // pg needs Node's net and tls; Hyperdrive gives it a pooled Postgres connection.
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs and Traces: every log line kept, one trace in ten sampled.
  "observability": {
    "enabled": true,
    // Invocation logs off: each carries the request's whole URL.
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "upload_source_maps": true,
  // APP_ORIGIN: the only host that keeps a theme cookie. ENVIRONMENT is "development"
  // only in a local run, where /studio/_design exists.
  "vars": {
    "APP_ORIGIN": "https://app.learningroutes.com",
    "ENVIRONMENT": "production",
    // Where the landing and the catalog live.
    "PLATFORM_ORIGIN": "https://learningroutes.com",
    // Each creator's page is [slug].CREATOR_DOMAIN (Platform STEP 4 §0).
    "CREATOR_DOMAIN": "learningroutes.com",
    // Public. Local runs use Cloudflare's test key (.dev.vars, playwright.config.ts).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF07D4JJqafpfnPC"
  },
  // Named hosts are custom domains, which take precedence over the wildcard route that
  // gives each creator's page its host.
  "routes": [
    { "pattern": "learningroutes.com", "custom_domain": true },
    { "pattern": "www.learningroutes.com", "custom_domain": true },
    { "pattern": "app.learningroutes.com", "custom_domain": true },
    { "pattern": "*.learningroutes.com/*", "zone_name": "learningroutes.com" }
  ],
  // The API, from pages and for the app's /api: one host, so one session cookie.
  "services": [
    { "binding": "API", "service": "learning-routes-api" },
    { "binding": "MCP", "service": "learning-routes-mcp" }
  ],
  // The storefront's reads (Platform STEP 4 §1): caching on, as lr_public, which reads
  // the public views and nothing else. Everything with a session goes through the API.
  "hyperdrive": [
    {
      "binding": "DB_PUBLIC",
      "id": "5f6364e7889c4625ac5a1cfa9e1507f3",
      // LOCAL ONLY: the lr_public role of docker-compose.yml.
      "localConnectionString": "postgres://lr_public:local-only-public@localhost:54318/learning_routes"
    }
  ]
}
