    "react-router": "8.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.64.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.1",
