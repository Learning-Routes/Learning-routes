{
  "name": "@learning-routes/api",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit",
    "cf-typegen": "wrangler types --strict-vars=false",
    "postinstall": "wrangler types --strict-vars=false",
    "db:migrate": "node scripts/migrate.ts",
    "smoke:new-creator": "tsx scripts/smoke-new-creator.ts",
    "db:lint": "squawk -c .squawk.toml drizzle/*.sql",
    "db:auth-schema": "auth generate --config src/auth/schema.config.ts --adapter drizzle --dialect postgresql --output auth-schema.generated.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:erase-user": "tsx scripts/erase-user.ts",
    "db:check": "node scripts/check-drizzle-sync.mjs",
    "db:measure-rls": "node scripts/measure-rls.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-storefront": "tsx scripts/seed-storefront.ts",
    "ops:bootstrap-owner": "tsx scripts/bootstrap-owner.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.13",
    "@better-auth/mcp": "1.7.13",
    "@better-auth/oauth-provider": "1.7.13",
    "@learning-routes/core": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@learning-routes/public-read": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/pg": "8.23.1",
    "auth": "1.7.13",
    "drizzle-kit": "0.31.11",
    "squawk-cli": "2.70.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
