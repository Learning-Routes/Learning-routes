{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-routes-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  // Reached only through the app's hosts: no workers.dev address, and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // pg needs Node's net and tls; Hyperdrive gives it a pooled Postgres connection.
  "compatibility_flags": ["nodejs_compat"],
  // Minified: an unminified Worker ships every name and comment in its dependencies.
  "minify": true,
  // Workers Logs and Traces: every log line kept, one trace in ten sampled.
  "observability": {
    "enabled": true,
    // No invocation logs: they carry each request's full URL. requestLog writes
    // the matched route's pattern instead.
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // The database is regional: run next to it (ADR 0005).
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
  // APP_ORIGIN: auth's base URL, its only trusted origin, and the only Origin a
  // non-GET request may carry. ENVIRONMENT is "development" only in .dev.vars,
  // where sign-in links go to the log; anywhere else they are mailed.
  "vars": {
    "APP_ORIGIN": "https://app.learningroutes.com",
    "ENVIRONMENT": "production",
    "EMAIL_FROM": "sign-in@mail.learningroutes.com",
    "CLOUDFLARE_ZONE_ID": "f31f9bc6fac8035305c2fab2e5ebc35f",
    // The hosts a Turnstile token may come from (Platform STEP 4 §6.3).
    "TURNSTILE_HOSTNAMES": "app.learningroutes.com",
    // Where an asset's address points: the content host (Platform STEP 9 §1).
    "CONTENT_ORIGIN": "https://contenido.learningroutes.com"
  },
  // Cloudflare Email Sending: sign-in links, from this one address only. The
  // domain is enabled with wrangler email sending enable (docs/runbooks/database.md).
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["sign-in@mail.learningroutes.com"] }
  ],
  // Set with wrangler secret put; locally in .dev.vars (git-ignored).
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "CLOUDFLARE_PURGE_TOKEN",
      "TURNSTILE_SECRET",
      // The content host's: it signs a draft creation's short-lived address (Platform STEP 9 §3).
      "CONTENT_SIGNING_SECRET"
    ]
  },
  // Purging the storefront's edge cache by tag, after the commit (Platform STEP 4 §1.4).
  // One consumer at a time, and at most one batch each 30 s, stays inside the Free
  // plan's 5 purges a minute; the plan is not assumed.
  "queues": {
    "producers": [{ "binding": "PURGE_QUEUE", "queue": "learning-routes-purge" }],
    "consumers": [
      {
        "queue": "learning-routes-purge",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_concurrency": 1,
        "max_retries": 5
      }
    ]
  },
  // Creations and assets (Platform STEP 9 §2): written after the commit, served by the
  // content Worker (apps/content), never from here.
  "r2_buckets": [{ "binding": "CREATIONS", "bucket_name": "learning-routes-creations" }],
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "6f1a3d1237a542af8b9d4b5329c41ded",
      // LOCAL ONLY: the lr_app role of docker-compose.yml, never the migrator.
      "localConnectionString": "postgres://lr_app:local-only-app@localhost:54318/learning_routes"
    }
  ]
}
