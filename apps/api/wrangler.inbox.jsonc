{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The real-user proof's private inbox (Platform STEP 10 §6): Email Routing delivers its
  // addresses here, and the proofs read their links with `wrangler kv`. Messages expire after a day.
  "name": "learning-routes-proof-inbox",
  "main": "src/proof-inbox/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  // No logs: a message holds a sign-in link.
  "observability": { "enabled": false },
  // Kept only from our own mail's domain (wrangler.jsonc's EMAIL_FROM), and only for the two test
  // addresses and the production student check's (STEP 11-prep §A3); anything else is refused.
  "vars": {
    "SENDER_DOMAIN": "mail.learningroutes.com",
    "ADDRESSES": "operator@proof.email.learningroutes.com,andres@proof.email.learningroutes.com,alumna@proof.email.learningroutes.com"
  },
  "kv_namespaces": [{ "binding": "INBOX", "id": "dfd3348d62a5498f9b041e92922b310d" }]
}
