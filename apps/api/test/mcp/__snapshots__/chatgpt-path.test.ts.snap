    "name": "get_route_format",
  },
  {
    "description": "Create a free route's empty draft in a space. Nobody sees it until publish_route. A price is set in the app, never here.",
    "name": "create_route",
  },
  {
    "description": "Change a draft's title, description, topic or level. Never its price or address.",
    "name": "update_route_details",
  },
  {
    "description": "Add a module to a route's draft.",
    "name": "add_module",
