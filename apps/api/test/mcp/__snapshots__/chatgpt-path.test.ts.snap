// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the way ChatGPT connects > keeps every tool's name and description the same from one deploy to the next 1`] = `
[
  {
    "description": "List the spaces you can teach in, with your role in each. Start here: every route lives in a space. To build a route, call get_route_format, then import_route; for a course they already wrote, upload_document.",
    "name": "list_spaces",
  },
  {
    "description": "List the routes of one space, with each draft's revision and published version.",
    "name": "list_routes",
  },
  {
    "description": "Read a route's draft: its details, modules, lessons and blocks, and the draft_revision every write needs.",
    "name": "get_route",
  },
  {
    "description": "Read how to write a route: the guide, with an example, and the JSON Schema of import_route's document. Call this before import_route.",
    "name": "get_route_format",
  },
  {
    "description": "Create a free route's empty draft in a space. Nobody sees it until publish_route. A price is set in the app, never here.",
    "name": "create_route",
  },
  {
    "description": "Change a draft's title, description, topic or level. Never its price or address.",
    "name": "update_route_details",
  },
  {
    "description": "Add a module to a route's draft.",
    "name": "add_module",
  },
  {
    "description": "Add a lesson to a module of a route's draft.",
    "name": "add_lesson",
  },
  {
    "description": "Add blocks to the end of a lesson: all of them, or none. Read the format in the resource learning-routes://guides/route-format.",
    "name": "add_blocks",
  },
  {
    "description": "Bring a document the creator already made, as it is: paste its Markdown or HTML, word for word, with no rewriting. The server makes the route: # is the title, ## a module, ### a lesson. It answers with a report of what went where, and a preview link to give the person. Sending the same document again changes nothing. Use this when the creator already has the course; to write a new one, use import_route.",
    "name": "upload_document",
  },
  {
    "description": "Import a whole route from one document: give space_id for a new draft, or route_id and draft_revision to replace an editable route's draft. All of it or nothing; a published version is never touched. Read the format in the resource learning-routes://guides/route-format, and its JSON Schema in learning-routes://schemas/route-document.",
    "name": "import_route",
  },
  {
    "description": "Publish a route's draft on the creator's public page, where students can start it. Do this only when the person asks. Answers with the public address.",
    "name": "publish_route",
  },
  {
    "description": "Bring an interactive creation the creator already made, like a piano, a game, a quiz or a simulator: one HTML file with its scripts and styles, up to 2 MB. Send the file exactly as it is: never rebuild, shorten or rewrite it, and never offer to remake it. It becomes an interactive block in a lesson and runs in its own box, where it cannot reach the internet, save data, open windows or show alerts. Answers with the block, the preview link to give the person, and what the creation will not be able to do here. Sending the same file to the same lesson again changes nothing.",
    "name": "upload_creation",
  },
  {
    "description": "Keep an image, a sound or a short video the creator has, and get its address to use in blocks (image_url, audio_url, video_url) or inside a creation. Give the file in base64 (up to about 2.5 MB this way), or an https address to take it from. Its type is read from its bytes: PNG, JPEG, GIF, WebP or SVG up to 5 MB; MP3, WAV, OGG or M4A up to 15 MB; MP4 or WebM up to 25 MB. The same file twice is one file.",
    "name": "upload_asset",
  },
]
`;
