#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ] && [ -f /usr/local/lib/libjemalloc.so ]; then
  export LD_PRELOAD=/usr/local/lib/libjemalloc.so
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  echo "Preparing all databases..."
  # No `|| echo ...` fallback. `|| ` suppresses `set -e`, so a failed migration
  # used to leave the container serving traffic on a half-migrated schema while
  # still passing /up. Failing here is deliberate: the container exits non-zero,
  # the Kamal healthcheck never goes green, and the rollout is refused instead of
  # silently corrupting a release.
  ./bin/rails db:prepare
  echo "Database preparation complete."
fi

exec "${@}"
